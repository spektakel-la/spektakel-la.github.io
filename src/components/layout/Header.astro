---
import Navigation from './Navigation.astro';
import { localePath } from '../../i18n/utils';
import type { Locale } from '../../i18n/utils';
import LanguageSwitchLink from './LanguageSwitchLink.astro';
import SiteLogo from '../ui/SiteLogo.astro';

interface Props {
  locale?: string;
}

const { locale = 'de' } = Astro.props;
const lang = locale as Locale;

const otherLocale = lang === 'de' ? 'en' : 'de';
const currentPath = Astro.url.pathname;

// Sprachumschalter: /de-pfad/ ↔ /en/de-pfad/
function switchLangHref(): string {
  if (lang === 'de') {
    // de → en: füge /en voran
    return '/en' + currentPath;
  } else {
    // en → de: entferne führendes /en
    return currentPath.replace(/^\/en/, '') || '/';
  }
}

const homeHref = localePath('/', lang);
---

<header
  class="sticky top-0 bg-white/95 backdrop-blur-sm border-b border-gray-100 shadow-sm relative"
  style="z-index: 1200;"
  role="banner"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href={homeHref} class="flex-shrink-0 flex items-center gap-3" aria-label="Spektakel Landshut – Startseite">
        <SiteLogo variant="header" />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-4">
        <Navigation locale={locale} />

        <!-- Sprachumschalter -->
        <LanguageSwitchLink href={switchLangHref()} locale={otherLocale} />
      </div>

      <!-- Mobile: Sprachumschalter + Hamburger -->
      <div class="flex lg:hidden items-center gap-3">
        <LanguageSwitchLink href={switchLangHref()} locale={otherLocale} variant="mobile" />

        <button
          id="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Menü öffnen"
          class="p-2 rounded hover:bg-gray-100 transition-colors"
        >
          <!-- Hamburger Icon -->
          <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Close Icon (initially hidden) -->
          <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" class="hidden">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

</header>

<!-- Mobile Menu Backdrop -->
<div
  id="mobile-menu-backdrop"
  class="hidden lg:hidden fixed inset-0 bg-black/25"
  style="z-index: 1250;"
  aria-hidden="true"
></div>

<!-- Mobile Menu (fixed, außerhalb des Headers, damit kein Stacking-Context-Clip) -->
<div
  id="mobile-menu"
  class="hidden lg:hidden fixed right-4 top-16 min-w-[180px] rounded-lg border border-gray-100 bg-white shadow-lg"
  style="z-index: 1300;"
  aria-hidden="true"
>
  <div class="py-2 px-2">
    <Navigation locale={locale} mobile={true} />
  </div>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const backdrop = document.getElementById('mobile-menu-backdrop');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  function closeMenu() {
    menu?.classList.add('hidden');
    menu?.setAttribute('aria-hidden', 'true');
    backdrop?.classList.add('hidden');
    backdrop?.setAttribute('aria-hidden', 'true');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Menü öffnen');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
  }

  function openMenu() {
    menu?.classList.remove('hidden');
    menu?.setAttribute('aria-hidden', 'false');
    backdrop?.classList.remove('hidden');
    backdrop?.setAttribute('aria-hidden', 'false');
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.setAttribute('aria-label', 'Menü schließen');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
  }

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden') === false;
    if (isOpen) closeMenu();
    else openMenu();
  });

  backdrop?.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  // Menü schließen bei Navigation (SPA-like)
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
