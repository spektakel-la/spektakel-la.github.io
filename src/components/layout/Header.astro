---
import Navigation from './Navigation.astro';
import { localePath } from '../../i18n/utils';
import type { Locale } from '../../i18n/utils';

interface Props {
  locale?: string;
}

const { locale = 'de' } = Astro.props;
const lang = locale as Locale;

const otherLocale = lang === 'de' ? 'en' : 'de';
const currentPath = Astro.url.pathname;

// Sprachumschalter: /de-pfad/ ↔ /en/de-pfad/
function switchLangHref(): string {
  if (lang === 'de') {
    // de → en: füge /en voran
    return '/en' + currentPath;
  } else {
    // en → de: entferne führendes /en
    return currentPath.replace(/^\/en/, '') || '/';
  }
}

const homeHref = localePath('/', lang);
---

<header
  class="sticky top-0 z-[var(--z-header)] bg-white/95 backdrop-blur-sm border-b border-gray-100 shadow-sm"
  role="banner"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href={homeHref} class="flex-shrink-0 flex items-center gap-3" aria-label="Spektakel Landshut – Startseite">
        <img
          src="/assets/img/logo/logo.png"
          alt="Spektakel Landshut Logo"
          width="140"
          height="60"
          class="h-12 w-auto object-contain"
          loading="eager"
        />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-4">
        <Navigation locale={locale} />

        <!-- Sprachumschalter -->
        <a
          href={switchLangHref()}
          class="ml-4 px-3 py-1.5 rounded border border-gray-300 text-xs font-bold uppercase tracking-widest
                 hover:border-[var(--color-primary)] hover:text-[var(--color-primary)] transition-colors"
          aria-label={otherLocale === 'en' ? 'Switch to English' : 'Zu Deutsch wechseln'}
        >
          {otherLocale === 'en' ? 'EN' : 'DE'}
        </a>
      </div>

      <!-- Mobile: Sprachumschalter + Hamburger -->
      <div class="flex lg:hidden items-center gap-3">
        <a
          href={switchLangHref()}
          class="px-2.5 py-1 rounded border border-gray-300 text-xs font-bold uppercase tracking-widest
                 hover:border-[var(--color-primary)] hover:text-[var(--color-primary)] transition-colors"
          aria-label={otherLocale === 'en' ? 'Switch to English' : 'Zu Deutsch wechseln'}
        >
          {otherLocale === 'en' ? 'EN' : 'DE'}
        </a>

        <button
          id="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Menü öffnen"
          class="p-2 rounded hover:bg-gray-100 transition-colors"
        >
          <!-- Hamburger Icon -->
          <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Close Icon (initially hidden) -->
          <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" class="hidden">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-gray-100 bg-white"
    aria-hidden="true"
  >
    <div class="max-w-7xl mx-auto px-4 py-4">
      <Navigation locale={locale} />
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden') === false;

    if (isOpen) {
      menu?.classList.add('hidden');
      menu?.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Menü öffnen');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    } else {
      menu?.classList.remove('hidden');
      menu?.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Menü schließen');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    }
  });

  // Menü schließen bei Navigation (SPA-like)
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      menu.setAttribute('aria-hidden', 'true');
      toggle?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
