---
import { type CollectionEntry } from 'astro:content';
import { type Category } from '../../../utils/categories';
import { type MergedEntry, formatTime } from '../../../utils/schedule';
import CategoryChip from '../../ui/CategoryChip.astro';

interface Props {
  artist: CollectionEntry<'artists'>;
  category: Category | '';
  basePath: string;
  locale: 'de' | 'en';
  entries?: MergedEntry[];
}

const { artist, category, basePath, locale, entries = [] } = Astro.props;
const { name, images, hut_act, image_position } = artist.data;
const imgPos = image_position ?? 'center';
const locData = locale === 'en' ? (artist.data.en ?? artist.data.de) : artist.data.de;
const img = images?.[0] ?? null;
const href = `${basePath}/artists/${artist.id}/`;

const DAY_SHORT: Record<string, string> = {
  '2026-09-18': 'Fr',
  '2026-09-19': 'Sa',
  '2026-09-20': 'So',
};

// Kompakte Spielzeiten: "Fr 16:00 | Sa 18:00"
const timeLine = entries
  .map((e) => `${DAY_SHORT[e.festivalDay] ?? e.festivalDay} ${formatTime(e.startTime)}`)
  .join(' | ');
---

<a
  href={href}
  class="artist-card group block bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-gray-100"
  data-category={category}
  data-name={name.toLowerCase()}
>
  <!-- Bild + Favorit-Stern -->
  <div class="relative aspect-[4/3] overflow-hidden bg-gray-100">
    {img ? (
      <img
        src={img}
        alt={name}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        style={`object-position: ${imgPos};`}
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-dark/20">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4z"/>
        </svg>
      </div>
    )}
    <!-- Favorit-Stern (top right) -->
    <button
      class="fav-card-btn absolute top-2 right-2 w-7 h-7 flex items-center justify-center rounded-full bg-white/80 backdrop-blur-sm text-dark/40 hover:text-primary transition-colors"
      data-artist-id={artist.data.artist_id}
      aria-label={locale === 'de' ? 'Merken' : 'Save'}
      onclick="event.preventDefault(); event.stopPropagation();"
    >
      <svg class="fav-card-icon w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.562.562 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
      </svg>
    </button>
  </div>

  <div class="p-3">
    <div class="flex items-start justify-between gap-2 mb-1">
      <h2 class="font-display text-base leading-tight text-dark group-hover:text-primary transition-colors line-clamp-2">
        {name}
      </h2>
      {hut_act && (
        <span class="shrink-0 text-xs bg-lime/30 text-dark/70 rounded px-1.5 py-0.5 font-sans" title={locale === 'de' ? 'Spielt für den Hut' : 'Performs for tips'}>
          🎩
        </span>
      )}
    </div>

    <!-- Kompakte Spielzeiten -->
    {timeLine && (
      <p class="text-xs text-dark/40 mb-2 leading-snug">{timeLine}</p>
    )}

    <!-- Kategorie-Chip -->
    {category && (
      <CategoryChip category={category} label={locData.categories[0] ?? category} class="shrink-0 text-xs pointer-events-none" />
    )}
  </div>
</a>
