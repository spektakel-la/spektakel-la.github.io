---
import { getCollection, type CollectionEntry } from 'astro:content';
import { festival } from '../../../data/festival';
import { useTranslations } from '../../../i18n/utils';
import Page from '../../../layouts/Page.astro';
import {
  getMacroCategoryFromCategories,
  getMacroCategoryFromRaw,
} from '../../../utils/categories';
import { imagePositionToObjectPosition } from '../../../utils/imagePosition';
import { preferWebp } from '../../../utils/imageVariants';
import { createFestivalEvent, createFestivalLocationPlace, formatSchemaDateTime } from '../../../utils/jsonLd';
import { createPerformanceId, formatTime, loadSchedule, mergeConsecutiveSlots } from '../../../utils/schedule';
import CategoryChip from '../../ui/CategoryChip.astro';
import MapPin from '../../ui/MapPin.astro';
import PaintSplatter from '../../ui/PaintSplatter.astro';
import Picture from '../../ui/Picture.astro';

interface Props {
  artist: CollectionEntry<'artists'>;
  locale: 'de' | 'en';
}

const { artist, locale } = Astro.props;
const t = useTranslations(locale);
const basePath = locale === 'en' ? '/en' : '';

const { name, images, facebook, instagram, youtube, vimeo, tiktok, homepage, hut_act, artist_id, duration, image_position } = artist.data;
const objectPosition = imagePositionToObjectPosition(image_position);
const locData = locale === 'en' ? (artist.data.en ?? artist.data.de) : artist.data.de;
const descriptionParagraphs = locData.description
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);

function createMetaDescription(description: string, maxLength = 160): string {
  const normalized = description.replace(/\s+/g, ' ').trim();
  if (normalized.length <= maxLength) return normalized;

  const limit = maxLength - 3;
  const sentenceEnd = normalized.slice(0, limit + 1).search(/[.!?](?=\s|$)[^.!?]*$/);
  if (sentenceEnd > 80) return `${normalized.slice(0, sentenceEnd + 1).trim()}`;

  const wordEnd = normalized.lastIndexOf(' ', limit);
  const end = wordEnd > 80 ? wordEnd : limit;
  return `${normalized.slice(0, end).trim()}...`;
}

const primaryCategory = locData.categories[0];
const artistTitle = primaryCategory
  ? locale === 'en'
    ? `${name} | ${primaryCategory} at Spektakel Landshut 2026`
    : `${name} | ${primaryCategory} beim Spektakel Landshut 2026`
  : locale === 'en'
    ? `${name} | Artist at Spektakel Landshut 2026`
    : `${name} | Künstler beim Spektakel Landshut 2026`;
const metaIntro = locale === 'en'
  ? `${name} at Spektakel Landshut 2026: `
  : `${name} beim Spektakel Landshut 2026: `;
const metaDescription = createMetaDescription(`${metaIntro}${locData.description}`);
const artistImageAlt = locale === 'en'
  ? `${name} at Spektakel Landshut 2026`
  : `${name} beim Spektakel Landshut 2026`;

const macroCategory = getMacroCategoryFromCategories(locData.categories ?? []);

// Auftritte laden
const schedule = loadSchedule();
const allLocations = await getCollection('locations');
const locationMap = Object.fromEntries(
  allLocations.map((l: CollectionEntry<'locations'>) => [l.data.location_id, l])
);

const artistEntries = schedule.filter((e) => e.artist_id === artist_id);
const merged = mergeConsecutiveSlots(artistEntries);

const dayFull: Record<string, string> = {
  '2026-09-18': locale === 'de' ? 'Freitag 18.09.' : 'Friday Sep 18',
  '2026-09-19': locale === 'de' ? 'Samstag 19.09.' : 'Saturday Sep 19',
  '2026-09-20': locale === 'de' ? 'Sonntag 20.09.' : 'Sunday Sep 20',
};

const mainImage = images?.[0] ?? null;
const mainImageForMetadata = mainImage ? preferWebp(mainImage) : null;
const mainImageUrl = mainImageForMetadata ? new URL(mainImageForMetadata, festival.siteUrl).href : null;
const extraImages = images?.slice(1) ?? [];

const catChipLabel = macroCategory ? (locData.categories[0] ?? macroCategory) : '';

// ─── Dauer → ISO 8601 für JSON-LD ────────────────────────────────────────────
function durationToISO(dur?: string): string | undefined {
  if (!dur) return undefined;
  const clean = dur.replace(/^ca\.\s*/i, '').trim();
  const hMatch = clean.match(/(\d+)\s*(?:stunde|stunden|hour|hours|h\b)/i);
  const mMatch = clean.match(/(\d+)\s*(?:minuten|minute|min\b|m\b)/i);
  const h = hMatch ? parseInt(hMatch[1]) : 0;
  const m = mMatch ? parseInt(mMatch[1]) : 0;
  if (h === 0 && m === 0) return undefined;
  return `PT${h > 0 ? `${h}H` : ''}${m > 0 ? `${m}M` : ''}`;
}
const durationISO = durationToISO(duration);

// ─── JSON-LD Person ──────────────────────────────────────────────────────────
const siteUrl = festival.siteUrl;
const artistUrl = `${siteUrl}${basePath}/artists/${artist_id}/`;
const programUrl = locale === 'en' ? `${siteUrl}/en/program/` : `${siteUrl}/program/`;
const locationsUrl = locale === 'en' ? `${siteUrl}/en/locations/` : `${siteUrl}/locations/`;
const eventSeriesId = `${programUrl}#event-series`;
const festivalLocationPlace = createFestivalLocationPlace(locationsUrl);

const sameAs: string[] = [
  instagram,
  facebook,
  youtube,
  vimeo,
  tiktok,
  homepage,
].filter((u): u is string => typeof u === 'string' && u.length > 0);

const keywords = locData.tags && locData.tags.length > 0 ? locData.tags.join(', ') : undefined;

const performerRef: Record<string, unknown> = { '@type': 'PerformingGroup', '@id': `${artistUrl}#artist`, name, url: artistUrl };
if (mainImageUrl) performerRef.image = mainImageUrl;

const performerIn = merged.map((entry) => {
  const loc = locationMap[entry.location_id];
  const eventId = createPerformanceId(entry);
  const eventUrl = `${programUrl}#${eventId}`;
  const venueUrl = loc ? `${locationsUrl}#venue-${loc.data.location_id}` : undefined;
  return createFestivalEvent({
    id: eventUrl,
    name: `${name} – ${festival.organizerName}`,
    description: metaDescription,
    startDate: formatSchemaDateTime(entry.startTime),
    endDate: formatSchemaDateTime(entry.endTime),
    url: eventUrl,
    performer: performerRef,
    image: mainImageUrl ?? undefined,
    duration: durationISO,
    location: loc
      ? {
        id: venueUrl,
        name: loc.data.description,
        gps: loc.data.gps,
        url: venueUrl,
        containedInPlace: festivalLocationPlace,
      }
      : undefined,
  });
});

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${artistUrl}#artist`,
  name,
  url: artistUrl,
  description: metaDescription,
  mainEntityOfPage: `${artistUrl}#webpage`,
};
if (mainImageUrl) jsonLd.image = mainImageUrl;
if (locData.country) jsonLd.nationality = locData.country;
if (keywords) jsonLd.keywords = keywords;
if (sameAs.length > 0) jsonLd.sameAs = sameAs;
if (performerIn.length > 0) jsonLd.performerIn = performerIn;

const webPageJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${artistUrl}#webpage`,
  url: artistUrl,
  name: artistTitle,
  description: metaDescription,
  inLanguage: locale === 'en' ? 'en-US' : 'de-DE',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Spektakel Landshut',
    url: siteUrl,
  },
  mainEntity: {
    '@id': `${artistUrl}#artist`,
  },
};
if (mainImageUrl) {
  webPageJsonLd.primaryImageOfPage = {
    '@type': 'ImageObject',
    url: mainImageUrl,
  };
}
---

<Page
  locale={locale}
  title={artistTitle}
  description={metaDescription}
  ogImage={mainImageForMetadata ?? undefined}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webPageJsonLd)} />
  <!-- ─── Top Bar: Back + Favorit ──────────────────────────────────────────── -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-5 pb-2 flex items-center justify-between">
    <a href={`${basePath}/artists/`} class="text-sm text-dark/50 hover:text-primary transition-colors">
      {t.common.backArtists}
    </a>
    <button
      class="fav-btn flex items-center gap-1.5 text-sm text-dark/40 hover:text-primary transition-colors"
      data-artist-id={artist_id}
      data-label-fav={t.common.favorited}
      data-label-unfav={t.common.favorite}
      aria-label={t.common.favorite}
    >
      <svg class="fav-icon w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.562.562 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
      </svg>
      <span class="fav-label hidden sm:inline">{t.common.favorite}</span>
    </button>
  </div>

  <!-- ─── Hero ────────────────────────────────────────────────────────────── -->
  <section class="relative bg-white overflow-hidden sm:[min-height:420px]">

    <!-- DESKTOP: Hashblur-Ambient (unter allem) -->
    {mainImage && (
      <div class="hidden sm:block absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
        <Picture
          src={mainImage}
          alt=""
          class="w-full h-full object-cover"
          style={`filter: blur(60px); transform: scale(1.2); object-position: ${objectPosition};`}
          loading="eager"
        />
      </div>
    )}

    <!-- DESKTOP: Künstlerbild rechts mit mask-image Einblendung (z-10) -->
    {mainImage && (
      <div
        class="hidden sm:block absolute right-0 top-0 bottom-0 w-1/2 z-10 pointer-events-none"
        style="-webkit-mask-image: linear-gradient(to right, transparent 0%, black 50%); mask-image: linear-gradient(to right, transparent 0%, black 50%);"
        aria-hidden="true"
      >
        <Picture
          src={mainImage}
          alt=""
          class="w-full h-full object-cover"
          style={`object-position: ${objectPosition};`}
          loading="eager"
        />
      </div>
    )}

    <!-- DESKTOP: Weißer Overlay-Gradient -->
    <div
      class="hidden sm:block absolute inset-0 z-20 pointer-events-none"
      aria-hidden="true"
      style="background: linear-gradient(to right, white 0%, white 22%, rgba(255,255,255,0.88) 32%, rgba(255,255,255,0.65) 42%, rgba(255,255,255,0.3) 54%, rgba(255,255,255,0.08) 64%, transparent 74%)"
    ></div>

    <!-- Splatter links: nur Desktop -->
    <div class="hidden sm:block absolute bottom-0 left-0 z-30 opacity-15 pointer-events-none" aria-hidden="true" style="width:220px; transform: translate(-20%, 30%);">
      <PaintSplatter variant={4} width={220} />
    </div>

    <!-- MOBILE: Künstlerbild als normaler Block vor dem Text -->
    {mainImage && (
      <div class="block sm:hidden w-full" style="height: 260px;" aria-hidden="true">
        <Picture
          src={mainImage}
          alt=""
          class="w-full h-full object-cover"
          style={`object-position: ${objectPosition};`}
          loading="eager"
        />
      </div>
    )}

    <!-- Text-Content links -->
    <div class="relative z-30 mx-auto max-w-7xl px-4 sm:px-6 py-8 sm:py-16">
      <div class="sm:w-3/5">
        {macroCategory && catChipLabel && (
          <div class="mb-4" style="filter: drop-shadow(0 0 6px rgba(255,255,255,0.95)); text-shadow: 1px 1px 6px rgba(255,255,255,0.95), -1px -1px 4px rgba(255,255,255,0.9);">
            <CategoryChip category={macroCategory} label={catChipLabel} class="pointer-events-none" />
          </div>
        )}

        <h1 class="font-display text-dark leading-none mb-6" style="font-size: clamp(2.5rem, 7vw, 5.5rem); text-shadow: 2px 2px 12px rgba(255,255,255,0.95), -1px -1px 8px rgba(255,255,255,0.9);">
          {name.toUpperCase()}
        </h1>

        <div class="flex flex-wrap items-center gap-4 text-dark/60 text-sm" style="text-shadow: 1px 1px 8px rgba(255,255,255,0.95), -1px -1px 6px rgba(255,255,255,0.9);">
          {locData.country && (
            <span class="flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
              </svg>
              {locale === 'de' ? 'AUS' : 'FROM'} {locData.country.toUpperCase()}
            </span>
          )}
          {duration && (
            <span class="flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {locale === 'de' ? 'DAUER' : 'DURATION'} {duration.toUpperCase()}
            </span>
          )}
          {hut_act && (
            <span class="flex items-center gap-1.5 text-primary font-semibold">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
              </svg>
              {t.common.hutAct.toUpperCase()}
            </span>
          )}
        </div>
      </div>
    </div>

  </section>

  <!-- ─── Body: 3 Spalten ────────────────────────────────────────────────────── -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <div class="grid grid-cols-1 md:grid-cols-[260px_1fr_220px] gap-8 lg:gap-12">

      <!-- ── Spalte 1: SPIELZEITEN ─────────────────────────────────────────── -->
      <div>
        <h2 class="font-display text-xs tracking-widest text-dark/50 uppercase mb-4">
          {locale === 'de' ? 'Spielzeiten' : 'Performances'}
        </h2>

        {merged.length === 0 ? (
          <p class="text-sm text-dark/40">{locale === 'de' ? 'Keine Termine verfügbar.' : 'No performances available.'}</p>
        ) : (
          <div class="flex flex-col gap-3">
            {merged.map((entry) => {
              const loc = locationMap[entry.location_id];
              const timeStr = `${formatTime(entry.startTime)} – ${formatTime(entry.endTime)}`;
              const locName = loc?.data.description ?? entry.location_id;
              return (
                <div class="rounded-xl border border-gray-200 p-4">
                  <p class="font-display text-xs tracking-widest text-dark/50 uppercase mb-1">
                    {dayFull[entry.festivalDay] ?? entry.festivalDay}
                  </p>
                  <p class="font-display text-xl text-dark leading-tight mb-2">{timeStr}</p>
                  <div class="flex items-center gap-1.5">
                    <MapPin color={loc?.data.marker_color ?? 'var(--color-primary)'} size={14} class="shrink-0" />
                    <span class="text-sm text-dark/70 font-medium uppercase">{locName}</span>
                  </div>
                </div>
              );
            })}
          </div>
        )}

        <div class="mt-5">
          <a href={`${basePath}/program/`} class="text-sm text-primary hover:underline">
            {t.common.toProgram}
          </a>
        </div>
      </div>

      <!-- ── Spalte 2: ÜBER [NAME] ─────────────────────────────────────────── -->
      <div>
        <h2 class="font-display text-xs tracking-widest text-dark/50 uppercase mb-4">
          {locale === 'de' ? `Über ${name}` : `About ${name}`}
        </h2>

        {locData.highlight && (
          <p class="highlight mb-4">
            „{locData.highlight}"
          </p>
        )}

        <div class="text-dark/70 leading-relaxed mb-6 space-y-4">
          {descriptionParagraphs.map((paragraph) => (
            <p class="whitespace-pre-line">{paragraph}</p>
          ))}
        </div>

        {(locData.categories?.length ?? 0) > 0 && (
          <div class="flex flex-wrap gap-2">
            {locData.categories.map((tag: string) => (
              <CategoryChip
                category={getMacroCategoryFromRaw(tag)}
                label={tag}
                class="pointer-events-none"
              />
            ))}
          </div>
        )}

        {extraImages.length > 0 && (
          <div class="mt-8">
            <div class="grid grid-cols-3 gap-2">
              {extraImages.slice(0, 3).map((img: string) => (
                <div class="rounded-lg overflow-hidden aspect-[4/3] bg-gray-100">
                  <Picture src={img} alt={artistImageAlt} loading="lazy" class="w-full h-full object-cover" />
                </div>
              ))}
            </div>
            {extraImages.length > 3 && (
              <a href="#gallery" class="mt-3 inline-block text-sm text-primary hover:underline">
                {t.common.moreImages}
              </a>
            )}
          </div>
        )}
      </div>

      <!-- ── Spalte 3: INFOS ───────────────────────────────────────────────── -->
      <div>
        <h2 class="font-display text-xs tracking-widest text-dark/50 uppercase mb-4">
          {locale === 'de' ? 'Infos' : 'Info'}
        </h2>

        <dl class="space-y-4 text-sm">
          {locData.age_recommendation && (
            <div>
              <dt class="font-display text-xs tracking-widest uppercase text-dark/40 mb-0.5">
                {locale === 'de' ? 'Altersempfehlung' : 'Age recommendation'}
              </dt>
              <dd class="text-dark/70">{locData.age_recommendation}</dd>
            </div>
          )}
          {locData.language && (
            <div>
              <dt class="font-display text-xs tracking-widest uppercase text-dark/40 mb-0.5">
                {locale === 'de' ? 'Sprache' : 'Language'}
              </dt>
              <dd class="text-dark/70">{locData.language}</dd>
            </div>
          )}
          {locData.special && (
            <div>
              <dt class="font-display text-xs tracking-widest uppercase text-dark/40 mb-0.5">
                {locale === 'de' ? 'Besonderes' : 'Special'}
              </dt>
              <dd class="text-dark/70">{locData.special}</dd>
            </div>
          )}
          {homepage && (
            <div>
              <dt class="font-display text-xs tracking-widest uppercase text-dark/40 mb-0.5">
                {locale === 'de' ? 'Webseite' : 'Website'}
              </dt>
              <dd>
                <a href={homepage} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline break-all" data-artist-id={artist_id} data-analytics-link-type="artist_website">
                  {new URL(homepage).hostname}
                </a>
              </dd>
            </div>
          )}
        </dl>

        {(instagram || facebook || youtube || vimeo || tiktok) && (
          <div class="mt-6">
            <p class="font-display text-xs tracking-widest uppercase text-dark/40 mb-3">Social Media</p>
            <div class="flex items-center gap-3">
              {instagram && (
                <a href={instagram} target="_blank" rel="noopener noreferrer" class="text-dark/40 hover:text-primary transition-colors" aria-label="Instagram" data-artist-id={artist_id}>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                  </svg>
                </a>
              )}
              {facebook && (
                <a href={facebook} target="_blank" rel="noopener noreferrer" class="text-dark/40 hover:text-primary transition-colors" aria-label="Facebook" data-artist-id={artist_id}>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                </a>
              )}
              {youtube && (
                <a href={youtube} target="_blank" rel="noopener noreferrer" class="text-dark/40 hover:text-primary transition-colors" aria-label="YouTube" data-artist-id={artist_id}>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                  </svg>
                </a>
              )}
              {vimeo && (
                <a href={vimeo} target="_blank" rel="noopener noreferrer" class="text-dark/40 hover:text-primary transition-colors" aria-label="Vimeo" data-artist-id={artist_id}>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M23.976 6.416c-.105 2.338-1.739 5.543-4.894 9.609-3.268 4.247-6.03 6.374-8.29 6.374-1.397 0-2.58-1.288-3.553-3.862-.647-2.363-1.295-4.73-1.943-7.093-.72-2.574-1.492-3.862-2.318-3.862-.18 0-.813.378-1.897 1.131L0 7.324c1.185-1.04 2.35-2.08 3.5-3.117C5.08 2.84 6.266 2.12 7.055 2.04c1.864-.18 3.01 1.096 3.44 3.831.465 2.953.79 4.79.97 5.51.54 2.45 1.133 3.674 1.78 3.674.504 0 1.26-.796 2.268-2.386 1.008-1.591 1.548-2.802 1.62-3.635.144-1.372-.396-2.059-1.62-2.059-.576 0-1.169.132-1.78.396 1.184-3.868 3.443-5.747 6.779-5.636 2.474.072 3.628 1.632 3.464 4.681z"/>
                  </svg>
                </a>
              )}
              {tiktok && (
                <a href={tiktok} target="_blank" rel="noopener noreferrer" class="text-dark/40 hover:text-primary transition-colors" aria-label="TikTok" data-artist-id={artist_id}>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 013.4-4.48V9.42a6.33 6.33 0 00-5.08 11.1 6.34 6.34 0 0010.86-4.43V9.16a8.16 8.16 0 004.77 1.52V7.23a4.85 4.85 0 01-1.53-.54z"/>
                  </svg>
