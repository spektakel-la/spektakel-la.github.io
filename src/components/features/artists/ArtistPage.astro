---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { useTranslations } from '../../../i18n/utils';
import { getArtistMacroCategory, getCategoryLabels } from '../../../utils/categories';
import { loadSchedule, mergeConsecutiveSlots, type MergedEntry } from '../../../utils/schedule';
import Page from '../../../layouts/Page.astro';
import PageHero from '../../layout/PageHero.astro';
import PaintSplatter from '../../ui/PaintSplatter.astro';
import CategoryFilter from '../program/CategoryFilter.astro';
import ArtistCard from './ArtistCard.astro';
import hero4 from '../../../assets/hero/hero4.webp';

interface Props {
  locale: 'de' | 'en';
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const basePath = locale === 'en' ? '/en' : '';

const allArtists: CollectionEntry<'artists'>[] = await getCollection('artists');

// Organizational-Acts herausfiltern, alphabetisch sortieren
const artists = allArtists
  .filter((a) => !a.data.organizational)
  .sort((a, b) => a.data.name.localeCompare(b.data.name, locale));

const categoryMap = Object.fromEntries(
  artists.map((a) => [a.id, getArtistMacroCategory(a.data, locale)])
);

// Schedule für Cards (Spielzeiten)
const allLocations = await getCollection('locations');
const locationMap = Object.fromEntries(
  allLocations.map((l: CollectionEntry<'locations'>) => [l.data.location_id, l])
);
const schedule = loadSchedule();
const scheduleMap: Record<string, MergedEntry[]> = {};
for (const artist of artists) {
  const entries = schedule.filter((e) => e.artist_id === artist.data.artist_id);
  const merged = mergeConsecutiveSlots(entries);
  scheduleMap[artist.id] = merged;
}

const catLabels = getCategoryLabels(t);
---

<Page
  locale={locale}
  title={t.artists.title}
  description={t.artists.tagline}
>
  <PageHero
    eyebrow="SPEKTAKEL LANDSHUT 2026"
    title={locale === 'de' ? 'ALLE KÜNSTLER' : 'ALL ARTISTS'}
    accentTitle={locale === 'de' ? 'AUF EINEN BLICK' : 'AT A GLANCE'}
    subtitle={t.artists.tagline}
  >
    <div slot="decor">
      <div class="absolute -top-16 -right-20 opacity-30">
        <PaintSplatter variant={3} width={520} />
      </div>
      <div class="absolute top-4 right-40 opacity-20">
        <PaintSplatter variant={5} width={300} />
      </div>
      <div class="absolute -bottom-12 -left-10 opacity-15">
        <PaintSplatter variant={1} width={300} />
      </div>
    </div>

    <div class="mt-6 inline-flex items-center gap-2 bg-dark text-white rounded-full px-4 py-2 text-sm font-display tracking-wider">
      <span aria-hidden="true">🎩</span>
      {t.common.hutAct.toUpperCase()}
    </div>

    <Image
      slot="media"
      src={hero4}
      alt=""
      aria-hidden="true"
      width={380}
      loading="eager"
      class="object-contain object-bottom max-h-[400px] w-auto"
    />
  </PageHero>

  <!-- ─── Filter-Bar ─────────────────────────────────────────────────────────── -->
  <div id="artists-filters" class="sticky top-0 z-30 bg-white border-b border-gray-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-2.5 flex items-center gap-3">
      <!-- Suche (fixe Breite, kein Schrumpfen) -->
      <div class="relative shrink-0 w-40 sm:w-56">
        <svg class="absolute left-2.5 top-1/2 -translate-y-1/2 text-dark/30 pointer-events-none" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.099zm-5.242 1.4a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11z"/>
        </svg>
        <input
          id="artist-search"
          type="search"
          placeholder={t.common.search}
          class="w-full pl-8 pr-3 py-1.5 text-sm border border-gray-200 rounded-full focus:outline-none focus:ring-2 focus:ring-primary/30"
          autocomplete="off"
          spellcheck="false"
        />
      </div>
      <!-- Kategorie-Chips wrappend -->
      <div class="flex-1 min-w-0">
        <CategoryFilter catLabels={catLabels} allLabel={t.common.all} locale={locale} />
      </div>
    </div>
  </div>

  <!-- ─── Künstler-Grid ──────────────────────────────────────────────────────── -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <div
      id="artists-grid"
      class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4"
    >
      {artists.map((artist) => (
        <ArtistCard
          artist={artist}
          category={categoryMap[artist.id] ?? ''}
          basePath={basePath}
          locale={locale}
          entries={scheduleMap[artist.id] ?? []}
        />
      ))}
    </div>

    <p id="no-results" class="hidden text-center text-dark/50 py-16">{t.program.noResults}</p>
  </div>
</Page>

<script>
  import { getFavorites, toggleFavorite } from '../../../utils/favorites';

  const searchInput = document.querySelector<HTMLInputElement>('#artist-search');
  const categoryBtns = document.querySelectorAll<HTMLButtonElement>('#artists-filters .chip');
  const cards = document.querySelectorAll<HTMLElement>('.artist-card');
  const noResults = document.querySelector<HTMLElement>('#no-results');

  let activeCategory = '';
  let searchTerm = '';
  let searchTimer: ReturnType<typeof setTimeout> | undefined;

  const track = (eventName: string, params: Record<string, unknown> = {}) => {
    window.spektakel?.analytics?.track(eventName, params);
  };

  function applyFilters() {
    let visible = 0;
    cards.forEach((card) => {
      const matchesCat = !activeCategory || card.dataset.category === activeCategory;
      const matchesSearch = !searchTerm || (card.dataset.name ?? '').includes(searchTerm);
      const show = matchesCat && matchesSearch;
      card.classList.toggle('hidden', !show);
      if (show) visible++;
    });
    noResults?.classList.toggle('hidden', visible > 0);
    return visible;
  }

  categoryBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.category ?? '';
      categoryBtns.forEach((b) => {
        b.classList.toggle('chip--active', (b.dataset.category ?? '') === activeCategory);
      });
      const visibleResults = applyFilters();
      track('artist_category_filtered', {
        category: activeCategory || 'all',
        search_active: searchTerm.length > 0,
        visible_results: visibleResults,
      });
    });
  });

  searchInput?.addEventListener('input', () => {
    searchTerm = (searchInput.value ?? '').toLowerCase().trim();
    const visibleResults = applyFilters();
    if (searchTimer) clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
      track('artist_search_used', {
        search_length: searchTerm.length,
        category: activeCategory || undefined,
        visible_results: visibleResults,
      });
    }, 600);
  });

  // ─── Favoriten-Sterne in Cards ────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.fav-card-btn').forEach((btn) => {
    const id = btn.dataset.artistId ?? '';
    const icon = btn.querySelector<SVGElement>('.fav-card-icon');
    const update = (isFav: boolean) => {
      btn.classList.toggle('text-primary', isFav);
      btn.classList.toggle('text-dark/40', !isFav);
      if (icon) icon.setAttribute('fill', isFav ? 'currentColor' : 'none');
    };
    update(getFavorites().has(id));
    btn.addEventListener('click', () => {
      const wasFavorite = getFavorites().has(id);
      const isFavorite = toggleFavorite(id);
      update(isFavorite);
      track(wasFavorite ? 'artist_favorite_removed' : 'artist_favorite_added', {
        artist_id: id,
        source: 'artist_grid',
        favorite_count: getFavorites().size,
      });
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('.artist-card[data-artist-id]').forEach((card) => {
    card.addEventListener('click', () => {
      track('artist_card_clicked', {
        artist_id: card.dataset.artistId,
        artist_name: card.dataset.artistName,
        category: card.dataset.category || undefined,
      });
    });
  });
</script>
