---
interface LocationOption {
  id: string;
  label: string;
}

interface Props {
  locations: LocationOption[];
  allLabel: string;
}

const { locations, allLabel } = Astro.props;
---

<select
  id="venue-filter"
  aria-label={allLabel}
  class="text-sm border border-gray-200 rounded-lg px-3 py-1.5 bg-white text-dark focus:outline-none focus:ring-2 focus:ring-primary/30"
>
  <option value="">{allLabel}</option>
  {locations.map((loc) => (
    <option value={loc.id}>{loc.label}</option>
  ))}
</select>
