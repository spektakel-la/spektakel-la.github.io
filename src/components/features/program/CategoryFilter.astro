---
import { type Category } from '../../../utils/categories';
import CategoryChip from '../../ui/CategoryChip.astro';

interface Props {
  catLabels: Record<Category, string>;
  allLabel: string;
  locale: 'de' | 'en';
  /** Kein Zeilenumbruch – für horizontales Scrollen in der Filter-Bar */
  nowrap?: boolean;
  /** Verdichtet die Chips auf sehr schmalen Displays. */
  compactMobile?: boolean;
}

const { catLabels, allLabel, locale, nowrap = false, compactMobile = false } = Astro.props;
---

<div
  class:list={[
    'flex gap-1.5',
    nowrap ? 'flex-nowrap' : 'flex-wrap',
    compactMobile && 'category-filter--compact-mobile',
  ]}
  role="group"
  aria-label={locale === 'de' ? 'Kategorie-Filter' : 'Category filter'}
>
  <CategoryChip label={allLabel} active={true} size="filter" data-category="" />
  {Object.entries(catLabels).map(([key, label]) => (
    <CategoryChip category={key as Category} label={label} active={false} size="filter" data-category={key as Category} />
  ))}
</div>

<style>
  @media (max-width: 479px) {
    .category-filter--compact-mobile :global(.chip--filter) {
      min-height: 1.75rem;
      padding: 0.2em 0.62em;
      font-size: clamp(0.65rem, 3vw, 0.75rem);
      letter-spacing: 0.035em;
    }

    .category-filter--compact-mobile :global(.chip__dot) {
      width: 7px;
      height: 7px;
    }
  }
</style>
