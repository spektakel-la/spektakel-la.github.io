---
import { type Category } from '../../../utils/categories';
import CategoryChip from '../../ui/CategoryChip.astro';

interface Props {
  catLabels: Record<Category, string>;
  allLabel: string;
  locale: 'de' | 'en';
  /** Kein Zeilenumbruch – für horizontales Scrollen in der Filter-Bar */
  nowrap?: boolean;
}

const { catLabels, allLabel, locale, nowrap = false } = Astro.props;
---

<div
  class={`flex gap-1.5 ${nowrap ? 'flex-nowrap' : 'flex-wrap'}`}
  role="group"
  aria-label={locale === 'de' ? 'Kategorie-Filter' : 'Category filter'}
>
  <CategoryChip label={allLabel} active={true} data-category="" />
  {Object.entries(catLabels).map(([key, label]) => (
    <CategoryChip category={key as Category} label={label} active={false} data-category={key as Category} />
  ))}
</div>
