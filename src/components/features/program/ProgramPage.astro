---
import { getCollection, type CollectionEntry } from 'astro:content';
import { useTranslations } from '../../../i18n/utils';
import {
  formatTime,
  getFestivalDays,
  groupByDay,
  loadSchedule,
  mergeConsecutiveSlots,
  sortFestivalTimeSlots,
  type MergedEntry,
  type ScheduleEntry,
} from '../../../utils/schedule';
import Page from '../../../layouts/Page.astro';
import PaintSplatter from '../../ui/PaintSplatter.astro';
import DayTabs from './DayTabs.astro';
import CategoryFilter from './CategoryFilter.astro';
import VenueFilter from './VenueFilter.astro';
import ProgramList from './ProgramList.astro';
import ProgramGrid from './ProgramGrid.astro';
import { Category, CATEGORY_KEYWORDS } from '../../../utils/categories';

interface Props {
  locale: 'de' | 'en';
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const basePath = locale === 'en' ? '/en' : '';

// ─── Daten laden ─────────────────────────────────────────────────────────────

const allArtists: CollectionEntry<'artists'>[] = await getCollection('artists');
const allLocations: CollectionEntry<'locations'>[] = await getCollection('locations');

const schedule = loadSchedule();
const byDay = groupByDay(schedule);
const days = getFestivalDays(schedule);

const artistMap = Object.fromEntries(allArtists.map((a) => [a.data.artist_id, a]));
const locationMap = Object.fromEntries(allLocations.map((l) => [l.data.location_id, l]));

// ─── Kategorie-Mapping ───────────────────────────────────────────────────────

function getMacroCategory(artistId: string): Category | '' {
  const artist = artistMap[artistId];
  if (!artist || artist.data.organizational) return '';
  const cats =
    locale === 'en'
      ? (artist.data.en?.categories ?? artist.data.de?.categories ?? [])
      : (artist.data.de?.categories ?? []);
  for (const cat of cats) {
    const c = cat.toLowerCase();
    for (const { cat: macro, keywords } of CATEGORY_KEYWORDS) {
      if (keywords.some((k) => c.includes(k))) return macro;
    }
  }
  return '';
}

const categoryMap: Record<string, Category | ''> = Object.fromEntries(
  allArtists.map((a) => [a.data.artist_id, getMacroCategory(a.data.artist_id)])
);

const catLabels: Record<Category, string> = {
  [Category.Akrobatik]: t.program.catAkrobatik,
  [Category.Musik]:     t.program.catMusik,
  [Category.Comedy]:    t.program.catComedy,
  [Category.Magie]:     t.program.catMagie,
  [Category.StreetArt]: t.program.catStreetArt,
};

function getDayLabel(dayStr: string): string {
  const d = new Date(dayStr + 'T12:00:00');
  const wd = d.getDay();
  if (wd === 5) return t.program.friday;
  if (wd === 6) return t.program.saturday;
  if (wd === 0) return t.program.sunday;
  return dayStr;
}

function getShortDate(dayStr: string): string {
  return new Date(dayStr + 'T12:00:00').toLocaleDateString('de-DE', {
    day: '2-digit',
    month: '2-digit',
  });
}

const dayItems = days.map((d) => ({ iso: d, label: getDayLabel(d), shortDate: getShortDate(d) }));

const venueOptions = allLocations
  .filter((l) => !l.data.organizational)
  .sort((a, b) => (a.data.sort_order ?? 99) - (b.data.sort_order ?? 99))
  .map((l) => ({ id: l.data.location_id, label: l.data.description }));

// ─── Tabellen-Grid (für ProgramGrid) ────────────────────────────────────────

type GridCell =
  | { kind: 'entry'; entry: ScheduleEntry; rowspan: number }
  | { kind: 'empty' }
  | { kind: 'spanned' }; // durch rowspan einer darüberliegenden Zelle abgedeckt

type TableGrid = {
  locations: CollectionEntry<'locations'>[];
  rows: { timeStr: string; isoTime: string; cells: Record<string, GridCell> }[];
};

function getLocationsForDay(dayStr: string): CollectionEntry<'locations'>[] {
  const ids = [...new Set((byDay[dayStr] ?? []).map((e) => e.location_id))];
  return allLocations
    .filter((l) => ids.includes(l.data.location_id))
    .sort((a, b) => (a.data.sort_order ?? 99) - (b.data.sort_order ?? 99));
}

function getTimeSlotsForDay(dayStr: string): string[] {
  const slots = [
    ...new Set(
      (byDay[dayStr] ?? [])
        .map((e) => formatTime(e.time)),
    ),
  ];
  // Chronologisch sortieren: 0–2 Uhr erscheint nach 23 Uhr (Festival geht über Mitternacht)
  return sortFestivalTimeSlots(slots);
}

function buildTableGrid(dayStr: string): TableGrid {
  const entries = byDay[dayStr] ?? [];
  const locations = getLocationsForDay(dayStr);
  const timeSlots = getTimeSlotsForDay(dayStr);

  // Aufbau: grid[timeStr][locId] = GridCell
  const grid: Record<string, Record<string, GridCell>> = {};
  for (const slot of timeSlots) {
    grid[slot] = {};
    for (const loc of locations) {
      grid[slot][loc.data.location_id] = { kind: 'empty' };
    }
  }
  for (const e of entries) {
    const slot = formatTime(e.time);
    if (grid[slot]) grid[slot][e.location_id] = { kind: 'entry', entry: e, rowspan: 1 };
  }

  // Aufeinanderfolgende gleiche Künstler pro Spalte mergen (rowspan)
  for (const loc of locations) {
    const locId = loc.data.location_id;
    for (let i = 0; i < timeSlots.length; i++) {
      const cell = grid[timeSlots[i]][locId];
      if (cell.kind !== 'entry') continue;
      let j = i + 1;
      while (j < timeSlots.length) {
        const next = grid[timeSlots[j]][locId];
        if (next.kind === 'entry' && next.entry.artist_id === cell.entry.artist_id) {
          cell.rowspan++;
          grid[timeSlots[j]][locId] = { kind: 'spanned' };
          j++;
        } else {
          break;
        }
      }
    }
  }

  const rows = timeSlots.map((timeStr) => {
    const firstEntry = entries.find((e) => formatTime(e.time) === timeStr);
    const cells: Record<string, GridCell> = {};
    for (const loc of locations) cells[loc.data.location_id] = grid[timeStr][loc.data.location_id];
    return { timeStr, isoTime: firstEntry?.time.toISOString() ?? '', cells };
  });

  return { locations, rows };
}

const tableGrids = Object.fromEntries(days.map((d) => [d, buildTableGrid(d)]));

// ─── Merged Entries für Listenansicht ────────────────────────────────────────

const mergedByDay: Record<string, MergedEntry[]> = Object.fromEntries(
  days.map((d) => [d, mergeConsecutiveSlots(byDay[d] ?? [])])
);

// ─── JSON-LD Events ──────────────────────────────────────────────────────────

const siteUrl = 'https://spektakel-la.github.io';
const programUrl = locale === 'en' ? `${siteUrl}/en/program/` : `${siteUrl}/program/`;

const jsonLdSubEvents = schedule
  .filter((e) => {
    const artist = artistMap[e.artist_id];
    return artist && !artist.data.organizational;
  })
  .map((e) => {
    const artist = artistMap[e.artist_id];
    const location = locationMap[e.location_id];
    const startIso = e.time.toISOString().replace('Z', '+02:00').replace(/\.\d{3}/, '');
    const endDate = new Date(e.time.getTime() + 45 * 60 * 1000);
    const endIso = endDate.toISOString().replace('Z', '+02:00').replace(/\.\d{3}/, '');
    const name = locale === 'en'
      ? (artist.data.en?.description ? artist.data.name : artist.data.name)
      : artist.data.name;
    const eventObj: Record<string, unknown> = {
      '@type': 'Event',
      name,
      startDate: startIso,
      endDate: endIso,
      url: programUrl,
      organizer: { '@type': 'Organization', name: 'Spektakel Landshut' },
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    };
    if (location) {
      eventObj.location = {
        '@type': 'Place',
        name: location.data.description,
        geo: {
          '@type': 'GeoCoordinates',
          latitude: location.data.gps[0],
          longitude: location.data.gps[1],
        },
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Landshut',
          addressCountry: 'DE',
        },
      };
    }
    return eventObj;
  });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EventSeries',
  name: 'Spektakel Landshut 2025',
  startDate: '2025-09-19',
  endDate: '2025-09-21',
  url: programUrl,
  location: {
    '@type': 'Place',
    name: 'Altstadt Landshut',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Landshut',
      addressCountry: 'DE',
    },
  },
  organizer: {
    '@type': 'Organization',
    name: 'Spektakel Landshut',
    url: siteUrl,
  },
  subEvent: jsonLdSubEvents,
};
---

<Page
  locale={locale}
  title={t.program.title}
  description={locale === 'de'
    ? 'Alle Auftritte beim Spektakel Landshut – täglich von Freitag bis Sonntag.'
    : 'All performances at Spektakel Landshut – Friday to Sunday.'}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <!-- ─── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="relative bg-white overflow-hidden py-16 md:py-20">
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-16 -right-20 opacity-25">
        <PaintSplatter variant={2} width={480} />
      </div>
      <div class="absolute -bottom-12 -left-10 opacity-20">
        <PaintSplatter variant={5} width={300} />
      </div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-6">
      <p class="text-primary font-display text-xl tracking-widest mb-1">SPEKTAKEL LANDSHUT 2025</p>
      <h1 class="font-display leading-none text-dark" style="font-size: clamp(3rem, 10vw, 7rem)">
        {t.program.title.toUpperCase()}
      </h1>
      <p class="mt-4 text-dark/40 text-sm">{t.common.disclaimer}</p>
    </div>
  </section>

  <!-- ─── Sticky Filter-Bar ────────────────────────────────────────────────── -->
  <div id="program-filters" class="sticky top-0 z-30 bg-white border-b border-gray-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <DayTabs
        days={dayItems}
        locale={locale}
        listViewLabel={t.program.listView}
        tableViewLabel={t.program.tableView}
      />
      <!-- Zeile 2: Kategorie-Chips + Spielort-Filter -->
      <div class="flex flex-wrap items-center gap-2 py-2 border-t border-gray-100">
        <CategoryFilter catLabels={catLabels} allLabel={t.common.all} locale={locale} />
        <div class="ml-auto">
          <VenueFilter locations={venueOptions} allLabel={t.common.allLocations} />
        </div>
      </div>
    </div>
  </div>

  <!-- ─── Programm-Inhalt ───────────────────────────────────────────────────── -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    {days.map((day, dayIdx) => (
      <div
        id={`panel-${day}`}
        role="tabpanel"
        aria-labelledby={`tab-${day}`}
        data-day-panel={day}
        class:list={[dayIdx !== 0 && 'hidden']}
      >
        <ProgramList
          entries={mergedByDay[day] ?? []}
          artistMap={artistMap}
          locationMap={locationMap}
          categoryMap={categoryMap}
          catLabels={catLabels}
          basePath={basePath}
          locale={locale}
          noResultsLabel={t.program.noResults}
          liveNowLabel={t.program.liveNow}
          hutActLabel={t.common.hutAct}
        />
        <ProgramGrid
          grid={tableGrids[day]}
          artistMap={artistMap}
          categoryMap={categoryMap}
          basePath={basePath}
          locale={locale}
        />
      </div>
    ))}
  </div>

</Page>

<script>
  // ─── Zustand ────────────────────────────────────────────────────────────────
  let activeDay = (document.querySelector<HTMLButtonElement>('[data-tab]'))?.dataset.day ?? '';
  let activeCategory = '';
  let activeVenue = '';
  let activeView: 'list' | 'table' = 'list';

  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
  const dayPanels = document.querySelectorAll<HTMLElement>('[data-day-panel]');
  const categoryBtns = document.querySelectorAll<HTMLButtonElement>('#program-filters .chip');
  const venueSelect = document.querySelector<HTMLSelectElement>('#venue-filter');
  const viewBtns = document.querySelectorAll<HTMLButtonElement>('[data-view-toggle]');

  // ─── Day-Tabs ────────────────────────────────────────────────────────────────
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      activeDay = tab.dataset.day ?? '';
      tabs.forEach((t) => {
        const active = t.dataset.day === activeDay;
        t.setAttribute('aria-selected', String(active));
        t.classList.toggle('border-primary', active);
        t.classList.toggle('text-primary', active);
        t.classList.toggle('border-transparent', !active);
        t.classList.toggle('text-dark/50', !active);
      });
      dayPanels.forEach((p) => p.classList.toggle('hidden', p.dataset.dayPanel !== activeDay));
      applyFilters();
    });
  });

  // ─── Kategorie-Chips ─────────────────────────────────────────────────────────
  categoryBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.category ?? '';
      categoryBtns.forEach((b) => {
        const isActive = (b.dataset.category ?? '') === activeCategory;
        b.classList.toggle('chip--active', isActive);
      });
      applyFilters();
    });
  });

  // ─── Spielort-Filter ─────────────────────────────────────────────────────────
  venueSelect?.addEventListener('change', () => {
    activeVenue = venueSelect.value;
    applyFilters();
  });

  // ─── Ansicht-Toggle ──────────────────────────────────────────────────────────
  function setView(view: 'list' | 'table') {
    activeView = view;
    viewBtns.forEach((b) => {
      const active = b.dataset.viewToggle === activeView;
      b.setAttribute('aria-pressed', String(active));
      b.classList.toggle('text-primary', active);
      b.classList.toggle('text-dark/40', !active);
      b.classList.toggle('hover:text-dark', !active);
    });
    document.querySelectorAll<HTMLElement>('[data-view-panel]').forEach((panel) => {
      panel.classList.toggle('hidden', panel.dataset.viewPanel !== activeView);
    });
  }

  viewBtns.forEach((btn) => {
    btn.addEventListener('click', () => setView((btn.dataset.viewToggle as 'list' | 'table') ?? 'list'));
  });

  // ─── Initial-Ansicht je Bildschirmbreite ─────────────────────────────────────
  setView(window.matchMedia('(min-width: 640px)').matches ? 'table' : 'list');

  // ─── Filterlogik ─────────────────────────────────────────────────────────────
  function applyFilters() {
    const activePanel = document.querySelector<HTMLElement>(`[data-day-panel="${activeDay}"]`);
    if (!activePanel) return;

    // Listen-Ansicht
    const entries = activePanel.querySelectorAll<HTMLElement>('.program-entry');
    let visible = 0;
    entries.forEach((entry) => {
      const ok =
        (!activeCategory || entry.dataset.category === activeCategory) &&
        (!activeVenue || entry.dataset.location === activeVenue);
      entry.classList.toggle('hidden', !ok);
      if (ok) visible++;
    });
    activePanel.querySelector<HTMLElement>('.no-results')?.classList.toggle('hidden', visible > 0);

    // Tabellen-Ansicht
    const tablePanel = activePanel.querySelector<HTMLElement>('[data-view-panel="table"]');
    if (tablePanel) {
      const noFilter = !activeCategory && !activeVenue;

      // Welche Spalten (location IDs) haben mindestens einen sichtbaren Eintrag?
      const visibleColIds = new Set<string>();
      if (noFilter) {
        tablePanel.querySelectorAll<HTMLElement>('col[data-col-id]').forEach((col) => {
          visibleColIds.add(col.dataset.colId!);
        });
      } else {
        tablePanel.querySelectorAll<HTMLElement>('td[data-category][data-col-id]').forEach((td) => {
          const cat = td.dataset.category ?? '';
          const loc = td.dataset.location ?? '';
          if (
            (!activeCategory || cat === activeCategory) &&
            (!activeVenue || loc === activeVenue)
          ) {
            visibleColIds.add(td.dataset.colId!);
          }
        });
      }

      // Spalten über <col visibility:collapse> ein-/ausblenden
      tablePanel.querySelectorAll<HTMLElement>('col[data-col-id]').forEach((col) => {
        col.style.visibility = visibleColIds.has(col.dataset.colId!) ? '' : 'collapse';
      });

      // Nicht-passende Entry-Zellen visuell ausblenden (Layout bleibt intakt)
      tablePanel.querySelectorAll<HTMLElement>('td[data-category][data-col-id]').forEach((td) => {
        const cat = td.dataset.category ?? '';
        const loc = td.dataset.location ?? '';
        const matches =
          (!activeCategory || cat === activeCategory) &&
          (!activeVenue || loc === activeVenue);
        const inner = td.querySelector<HTMLElement>('div');
        if (inner) inner.style.visibility = noFilter || matches ? '' : 'hidden';
      });

      // Zeilen ausblenden wenn kein sichtbarer Entry-Cell in sichtbarer Spalte vorhanden
      tablePanel.querySelectorAll<HTMLElement>('.table-row').forEach((row) => {
        if (noFilter) {
          row.classList.remove('hidden');
          return;
        }
        let rowOk = false;
        row.querySelectorAll<HTMLElement>('td[data-category][data-col-id]').forEach((td) => {
          const cat = td.dataset.category ?? '';
          const loc = td.dataset.location ?? '';
          if (
            visibleColIds.has(td.dataset.colId!) &&
            (!activeCategory || cat === activeCategory) &&
            (!activeVenue || loc === activeVenue)
          ) {
            rowOk = true;
          }
        });
        row.classList.toggle('hidden', !rowOk);
      });
    }
  }

  // ─── Live-Indikator ──────────────────────────────────────────────────────────
  function updateLive() {
    const now = Date.now();
    const SLOT = 30 * 60 * 1000;
    document.querySelectorAll<HTMLElement>('[data-time-start]').forEach((el) => {
      const start = new Date(el.dataset.timeStart ?? '').getTime();
      if (isNaN(start)) return;
      const live = now >= start && now < start + SLOT;
      el.querySelectorAll<HTMLElement>('.live-dot').forEach((d) => d.classList.toggle('hidden', !live));
    });
  }
  updateLive();
  setInterval(updateLive, 60_000);
</script>
