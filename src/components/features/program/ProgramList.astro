---
import { type CollectionEntry } from 'astro:content';
import { type Category } from '../../../utils/categories';
import { createPerformanceId, formatTime, type MergedEntry } from '../../../utils/schedule';
import CategoryChip from '../../ui/CategoryChip.astro';
import { formatLocationLabel } from '../../../utils/locations';

interface Props {
  entries: MergedEntry[];
  artistMap: Record<string, CollectionEntry<'artists'>>;
  locationMap: Record<string, CollectionEntry<'locations'>>;
  categoryMap: Record<string, Category | ''>;
  catLabels: Record<string, string>;
  basePath: string;
  locale: 'de' | 'en';
  noResultsLabel: string;
  liveNowLabel: string;
  hutActLabel: string;
  timeUntilLabel: string;
}

const {
  entries,
  artistMap,
  locationMap,
  categoryMap,
  catLabels,
  basePath,
  noResultsLabel,
  liveNowLabel,
  hutActLabel,
  timeUntilLabel,
  locale,
} = Astro.props;
---

<div data-view-panel="list" class="program-list-panel sm:mx-auto sm:max-w-5xl">
  <div class="program-list-entries divide-y divide-gray-200/70 sm:divide-gray-100">
    {entries.map((entry) => {
      const artist = artistMap[entry.artist_id];
      const location = locationMap[entry.location_id];
      const cat = categoryMap[entry.artist_id] ?? '';
      const isOrg = artist?.data.organizational ?? false;
      const artistName = artist?.data.name ?? entry.artist_id;
      const artistSlug = artist?.id ?? '';
      const locationLabel = location
        ? formatLocationLabel(
            location.data.location_id,
            location.data.description,
            location.data.location_label,
          )
        : entry.location_id;
      const startTimeLabel = formatTime(entry.startTime);
      const endTimeLabel = formatTime(entry.endTime);
      const timeLabel = `${startTimeLabel} – ${endTimeLabel}`;
      const specialLabel = locale === 'en' ? entry.label_en : entry.label_de;
      const performanceId = createPerformanceId(entry);

      return (
        <div
          id={performanceId}
          class="program-entry grid grid-cols-[4.75rem_minmax(0,1fr)] items-start gap-x-4 gap-y-2 py-4 px-3 sm:flex sm:flex-nowrap sm:items-center sm:gap-3 sm:py-3 sm:px-2 lg:grid lg:grid-cols-[11rem_minmax(12rem,1fr)_minmax(10rem,14rem)_auto] lg:gap-5 rounded-lg hover:bg-bg transition-colors"
          tabindex="-1"
          data-artist={entry.artist_id}
          data-location={entry.location_id}
          data-category={cat}
          data-time-start={entry.startTime.toISOString()}
          data-time-end={entry.endTime.toISOString()}
        >
          <span class="program-entry-time font-mono text-[1.0625rem] leading-tight sm:text-lg sm:leading-7 font-bold sm:font-semibold text-dark/80 sm:text-dark/60 shrink-0 whitespace-nowrap">
            <span class="flex flex-col gap-0.5 sm:hidden">
              <span>{startTimeLabel}</span>
              <span class="text-[0.8125rem] font-semibold leading-tight text-dark/60">{timeUntilLabel} {endTimeLabel}</span>
            </span>
            <span class="hidden sm:inline">{timeLabel}</span>
          </span>
          <span
            class="live-dot hidden shrink-0 w-2 h-2 rounded-full bg-primary animate-pulse"
            aria-label={liveNowLabel}
          />

          <div class="flex-1 min-w-0">
            <span class="program-entry-title-row inline-flex max-w-full items-center gap-1.5 align-top">
              {isOrg ? (
                <span class="block font-display text-lg sm:text-base leading-[1.08] sm:leading-tight text-dark/85 sm:text-dark/70 break-words hyphens-auto">{artistName}</span>
              ) : (
                <a
                  href={`${basePath}/artists/${artistSlug}/`}
                  class="inline-block font-display text-lg sm:text-base leading-[1.08] sm:leading-tight text-dark hover:text-primary transition-colors break-words hyphens-auto"
                >
                  {artistName}
                </a>
              )}
              <span class="program-favorite-star hidden shrink-0 text-primary" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor">
                  <path d="m12 2.4 2.9 6 6.6 1-4.8 4.7 1.1 6.6L12 17.6l-5.8 3.1 1.1-6.6-4.8-4.7 6.6-1L12 2.4Z" />
                </svg>
              </span>
            </span>
            {artist?.data.hut_act && (
              <span class="ml-2 inline-block text-xs bg-lime text-dark px-2 py-0.5 rounded font-display">
                🎩 {hutActLabel}
              </span>
            )}
            {entry.notes && !specialLabel && (
              <span class="ml-2 text-xs text-dark/40">{entry.notes}</span>
            )}
            {specialLabel && (
              <span class="mt-1 block w-fit rounded-sm bg-primary/10 px-2 py-0.5 text-xs font-semibold leading-tight text-primary">
                {specialLabel}
              </span>
            )}
            <span class="program-entry-location mt-1 block sm:hidden text-sm font-medium leading-snug text-dark/65">
              {locationLabel}
            </span>
            {cat && (
              <span class="mt-2 block sm:hidden">
                <CategoryChip
                  category={cat || undefined}
                  label={catLabels[cat] ?? cat}
                  active={false}
                  size="sm"
                  class="program-entry-category pointer-events-none"
                />
              </span>
            )}
          </div>

          <span class="text-sm text-dark/50 shrink-0 hidden sm:inline lg:justify-self-end lg:text-right">
            {locationLabel}
          </span>

          {cat && (
            <span class="hidden shrink-0 sm:inline-flex">
              <CategoryChip
                category={cat || undefined}
                label={catLabels[cat] ?? cat}
                active={false}
                size="sm"
                class="program-entry-category pointer-events-none"
              />
            </span>
          )}
        </div>
      );
    })}
  </div>

  <p class="no-results hidden text-center text-dark/40 py-12">
    {noResultsLabel}
  </p>
</div>

<style>
  .program-entry[data-deep-link-highlight="true"] {
    background: color-mix(in srgb, var(--color-primary) 9%, white);
    box-shadow: inset 4px 0 0 var(--color-primary);
  }

  .program-entry[data-favorite="true"] {
    background: color-mix(in srgb, var(--color-primary) 5%, white);
    box-shadow: inset 3px 0 0 color-mix(in srgb, var(--color-primary) 82%, white);
  }

  .program-entry[data-favorite="true"] .program-favorite-star {
    display: inline-flex;
  }

  .program-entry[data-favorite="true"]:hover {
    background: color-mix(in srgb, var(--color-primary) 7%, var(--color-bg));
  }

  .program-entry[data-deep-link-highlight="true"][data-favorite="true"] {
    background: color-mix(in srgb, var(--color-primary) 10%, white);
    box-shadow: inset 4px 0 0 var(--color-primary);
  }

  .program-entry:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  @media (min-width: 1024px) {
    .program-list-entries {
      border-top: 1px solid color-mix(in srgb, var(--color-dark) 10%, transparent);
    }

    .program-list-entries > .program-entry {
      border-color: color-mix(in srgb, var(--color-dark) 10%, transparent);
    }
  }

  @media (max-width: 639px) {
    :global(.program-entry-category.chip) {
      gap: 0.35em;
      padding: 0.2em 0.65em;
      border-color: color-mix(in srgb, var(--color-border) 82%, var(--color-dark));
      color: color-mix(in srgb, var(--color-dark) 88%, var(--color-white));
      font-size: 0.8125rem;
      letter-spacing: 0.035em;
      line-height: 1.2;
    }

    :global(.program-entry-category.chip .chip__dot) {
      width: 7px;
      height: 7px;
    }
  }
</style>
