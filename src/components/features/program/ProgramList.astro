---
import { type CollectionEntry } from 'astro:content';
import { type Category } from '../../../utils/categories';
import { formatTime, type MergedEntry } from '../../../utils/schedule';
import CategoryChip from '../../ui/CategoryChip.astro';

interface Props {
  entries: MergedEntry[];
  artistMap: Record<string, CollectionEntry<'artists'>>;
  locationMap: Record<string, CollectionEntry<'locations'>>;
  categoryMap: Record<string, Category | ''>;
  catLabels: Record<string, string>;
  basePath: string;
  locale: 'de' | 'en';
  noResultsLabel: string;
  liveNowLabel: string;
  hutActLabel: string;
}

const {
  entries,
  artistMap,
  locationMap,
  categoryMap,
  catLabels,
  basePath,
  noResultsLabel,
  liveNowLabel,
  hutActLabel,
  locale,
} = Astro.props;
---

<div data-view-panel="list">
  <div class="divide-y divide-gray-100">
    {entries.map((entry) => {
      const artist = artistMap[entry.artist_id];
      const location = locationMap[entry.location_id];
      const cat = categoryMap[entry.artist_id] ?? '';
      const isOrg = artist?.data.organizational ?? false;
      const artistName = artist?.data.name ?? entry.artist_id;
      const artistSlug = artist?.id ?? '';
      const locationLabel = location?.data.description ?? entry.location_id;
      const timeLabel = `${formatTime(entry.startTime)} – ${formatTime(entry.endTime)}`;
      const specialLabel = locale === 'en' ? entry.label_en : entry.label_de;

      return (
        <div
          class="program-entry flex flex-wrap sm:flex-nowrap items-center gap-3 py-3 px-2 rounded-lg hover:bg-bg transition-colors"
          tabindex="-1"
          data-artist={entry.artist_id}
          data-location={entry.location_id}
          data-category={cat}
          data-time-start={entry.startTime.toISOString()}
          data-time-end={entry.endTime.toISOString()}
        >
          <span class="program-entry-time font-mono text-base sm:text-lg font-semibold text-dark/60 shrink-0 whitespace-nowrap">
            {timeLabel}
          </span>
          <span
            class="live-dot hidden shrink-0 w-2 h-2 rounded-full bg-primary animate-pulse"
            aria-label={liveNowLabel}
          />

          <div class="flex-1 min-w-0">
            {isOrg ? (
              <span class="block font-display text-base leading-tight text-dark/70 break-words hyphens-auto">{artistName}</span>
            ) : (
              <a
                href={`${basePath}/artists/${artistSlug}/`}
                class="inline-block font-display text-base leading-tight text-dark hover:text-primary transition-colors break-words hyphens-auto"
              >
                {artistName}
              </a>
            )}
            {artist?.data.hut_act && (
              <span class="ml-2 inline-block text-xs bg-lime text-dark px-2 py-0.5 rounded font-display">
                🎩 {hutActLabel}
              </span>
            )}
            {entry.notes && !specialLabel && (
              <span class="ml-2 text-xs text-dark/40">{entry.notes}</span>
            )}
            {specialLabel && (
              <span class="mt-1 block w-fit rounded-sm bg-primary/10 px-2 py-0.5 text-xs font-semibold leading-tight text-primary">
                {specialLabel}
              </span>
            )}
            <span class="program-entry-location mt-1 block sm:hidden text-xs font-medium leading-tight text-dark/45">
              {locationLabel}
            </span>
          </div>

          <span class="text-sm text-dark/50 shrink-0 hidden sm:inline">
            {locationLabel}
          </span>

          {cat && (
            <CategoryChip
              category={cat || undefined}
              label={catLabels[cat] ?? cat}
              active={false}
              size="sm"
              class="shrink-0 pointer-events-none"
            />
          )}
        </div>
      );
    })}
  </div>

  <p class="no-results hidden text-center text-dark/40 py-12">
    {noResultsLabel}
  </p>
</div>

<style>
  .program-entry[data-deep-link-highlight="true"] {
    background: color-mix(in srgb, var(--color-primary) 9%, white);
    box-shadow: inset 4px 0 0 var(--color-primary);
  }

  .program-entry:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }
</style>
