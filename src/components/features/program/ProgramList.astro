---
import { type CollectionEntry } from 'astro:content';
import { type Category } from '../../../utils/categories';
import { createPerformanceId, formatTime, type MergedEntry } from '../../../utils/schedule';
import CategoryChip from '../../ui/CategoryChip.astro';
import { formatLocationLabel } from '../../../utils/locations';
import { imagePositionToObjectPosition } from '../../../utils/imagePosition';
import Picture from '../../ui/Picture.astro';

interface Props {
  entries: MergedEntry[];
  artistMap: Record<string, CollectionEntry<'artists'>>;
  locationMap: Record<string, CollectionEntry<'locations'>>;
  categoryMap: Record<string, Category | ''>;
  catLabels: Record<string, string>;
  basePath: string;
  locale: 'de' | 'en';
  noResultsLabel: string;
  hutActLabel: string;
  timeUntilLabel: string;
  showArtistInfoLabel: string;
  hideArtistInfoLabel: string;
  moreAboutArtistLabel: string;
}

const {
  entries,
  artistMap,
  locationMap,
  categoryMap,
  catLabels,
  basePath,
  noResultsLabel,
  hutActLabel,
  timeUntilLabel,
  showArtistInfoLabel,
  hideArtistInfoLabel,
  moreAboutArtistLabel,
  locale,
} = Astro.props;
---

<div data-view-panel="list" class="program-list-panel sm:mx-auto sm:max-w-5xl">
  <div class="program-list-entries divide-y divide-gray-200/70 sm:divide-gray-100">
    {entries.map((entry) => {
      const artist = artistMap[entry.artist_id];
      const location = locationMap[entry.location_id];
      const cat = categoryMap[entry.artist_id] ?? '';
      const isOrg = artist?.data.organizational ?? false;
      const artistName = artist?.data.name ?? entry.artist_id;
      const artistSlug = artist?.id ?? '';
      const locationLabel = location
        ? formatLocationLabel(
            location.data.location_id,
            location.data.description,
            location.data.location_label,
          )
        : entry.location_id;
      const startTimeLabel = formatTime(entry.startTime);
      const endTimeLabel = formatTime(entry.endTime);
      const timeLabel = `${startTimeLabel} – ${endTimeLabel}`;
      const specialLabel = locale === 'en' ? entry.label_en : entry.label_de;
      const performanceId = createPerformanceId(entry);
      const localizedArtistData = artist
        ? locale === 'en'
          ? (artist.data.en ?? artist.data.de)
          : artist.data.de
        : null;
      const previewDescription = localizedArtistData?.description
        .split(/\n\s*\n/)[0]
        ?.trim() ?? '';
      const previewImage = artist?.data.images?.[0] ?? '';
      const previewImagePosition = imagePositionToObjectPosition(artist?.data.image_position);
      const previewId = `${performanceId}-preview`;
      const hasPreview = !isOrg && Boolean(artist && (previewImage || previewDescription));

      return (
        <div
          id={performanceId}
          class="program-entry rounded-lg hover:bg-bg transition-colors"
          tabindex="-1"
          data-artist={entry.artist_id}
          data-location={entry.location_id}
          data-category={cat}
          data-time-start={entry.startTime.toISOString()}
          data-time-end={entry.endTime.toISOString()}
        >
          <div class="program-entry-summary grid grid-cols-[4.75rem_minmax(0,1fr)] items-start gap-x-4 gap-y-2 py-4 px-3 sm:flex sm:flex-nowrap sm:items-center sm:gap-3 sm:py-3 sm:px-2 lg:grid lg:grid-cols-[11rem_minmax(12rem,1fr)_minmax(10rem,14rem)_auto] lg:gap-5">
            <span class="program-entry-time font-mono text-[1.0625rem] leading-tight sm:text-lg sm:leading-7 font-bold sm:font-semibold text-dark/80 sm:text-dark/60 shrink-0 whitespace-nowrap">
              <span class="flex flex-col gap-0.5 sm:hidden">
                <span>{startTimeLabel}</span>
                <span class="text-[0.8125rem] font-semibold leading-tight text-dark/60">{timeUntilLabel} {endTimeLabel}</span>
              </span>
              <span class="hidden sm:inline">{timeLabel}</span>
            </span>

            <div class="flex-1 min-w-0">
              <span class="program-entry-title-row inline-flex max-w-full items-center gap-1.5 align-top">
                {isOrg ? (
                  <span class="block font-display text-lg sm:text-base leading-[1.08] sm:leading-tight text-dark/85 sm:text-dark/70 break-words hyphens-auto">{artistName}</span>
                ) : hasPreview ? (
                  <button
                    type="button"
                    class="program-entry-preview-toggle inline-flex max-w-full items-center gap-1.5 text-left font-display text-lg sm:text-base leading-[1.08] sm:leading-tight text-dark hover:text-primary transition-colors break-words hyphens-auto"
                    aria-expanded="false"
                    aria-controls={previewId}
                    aria-label={`${showArtistInfoLabel}: ${artistName}`}
                    data-program-preview-toggle
                    data-label-open={showArtistInfoLabel}
                    data-label-close={hideArtistInfoLabel}
                    data-artist-name={artistName}
                  >
                    <span>{artistName}</span>
                    <svg class="program-entry-preview-chevron h-3.5 w-3.5 shrink-0 transition-transform" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                      <path d="m5 7.5 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </button>
                ) : (
                  <a
                    href={`${basePath}/artists/${artistSlug}/`}
                    class="inline-block font-display text-lg sm:text-base leading-[1.08] sm:leading-tight text-dark hover:text-primary transition-colors break-words hyphens-auto"
                  >
                    {artistName}
                  </a>
                )}
                <span class="program-favorite-star hidden shrink-0 text-primary" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor">
                    <path d="m12 2.4 2.9 6 6.6 1-4.8 4.7 1.1 6.6L12 17.6l-5.8 3.1 1.1-6.6-4.8-4.7 6.6-1L12 2.4Z" />
                  </svg>
                </span>
              </span>
              {artist?.data.hut_act && (
                <span class="ml-2 inline-block text-xs bg-lime text-dark px-2 py-0.5 rounded font-display">
                  🎩 {hutActLabel}
                </span>
              )}
              {entry.notes && !specialLabel && (
                <span class="ml-2 text-xs text-dark/40">{entry.notes}</span>
              )}
              {specialLabel && (
                <span class="mt-1 block w-fit rounded-sm bg-primary/10 px-2 py-0.5 text-xs font-semibold leading-tight text-primary">
                  {specialLabel}
                </span>
              )}
              <span class="program-entry-location mt-1 block sm:hidden text-sm font-medium leading-snug text-dark/65">
                {locationLabel}
              </span>
              {cat && (
                <span class="mt-2 block sm:hidden">
                  <CategoryChip
                    category={cat || undefined}
                    label={catLabels[cat] ?? cat}
                    active={false}
                    size="sm"
                    class="program-entry-category pointer-events-none"
                  />
                </span>
              )}
            </div>

            <span class="text-sm text-dark/50 shrink-0 hidden sm:inline lg:justify-self-end lg:text-right">
              {locationLabel}
            </span>

            {cat && (
              <span class="hidden shrink-0 sm:inline-flex">
                <CategoryChip
                  category={cat || undefined}
                  label={catLabels[cat] ?? cat}
                  active={false}
                  size="sm"
                  class="program-entry-category pointer-events-none"
                />
              </span>
            )}
          </div>

          {hasPreview && (
            <div
              id={previewId}
              class="program-entry-preview px-3 pb-4 sm:px-2 sm:pb-3"
              data-program-preview
              hidden
            >
              <div class:list={[
                'grid gap-3 pt-3 sm:gap-4',
                previewImage ? 'grid-cols-[5.5rem_minmax(0,1fr)] sm:grid-cols-[7rem_minmax(0,1fr)]' : 'grid-cols-1',
              ]}>
                {previewImage && (
                  <div class="aspect-square overflow-hidden rounded-lg bg-gray-100">
                    <Picture
                      src={previewImage}
                      alt={artistName}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover"
                      style={`object-position: ${previewImagePosition};`}
                    />
                  </div>
                )}
                <div class="min-w-0 self-center">
                  {previewDescription && (
                    <p class="program-entry-preview-description text-sm leading-relaxed text-dark/70">
                      {previewDescription}
                    </p>
                  )}
                  <a
                    href={`${basePath}/artists/${artistSlug}/`}
                    class="mt-2 inline-block text-sm font-semibold text-primary hover:underline"
                  >
                    {moreAboutArtistLabel} {artistName} →
                  </a>
                </div>
              </div>
            </div>
          )}
        </div>
      );
    })}
  </div>

  <p class="no-results hidden text-center text-dark/40 py-12">
    {noResultsLabel}
  </p>
</div>

<script>
  function setProgramPreviewExpanded(toggle: HTMLButtonElement, expanded: boolean) {
    const previewId = toggle.getAttribute('aria-controls');
    const preview = previewId ? document.getElementById(previewId) : null;
    if (!preview) return;

    toggle.setAttribute('aria-expanded', String(expanded));
    const artistName = toggle.dataset.artistName ?? '';
    const label = expanded ? toggle.dataset.labelClose : toggle.dataset.labelOpen;
    toggle.setAttribute('aria-label', `${label ?? ''}: ${artistName}`);
    toggle.querySelector('.program-entry-preview-chevron')?.classList.toggle('rotate-180', expanded);
    preview.hidden = !expanded;
  }

  document.querySelectorAll<HTMLButtonElement>('[data-program-preview-toggle]').forEach((toggle) => {
    if (toggle.dataset.previewReady === 'true') return;
    toggle.dataset.previewReady = 'true';
    toggle.addEventListener('click', () => {
      const shouldExpand = toggle.getAttribute('aria-expanded') !== 'true';
      document.querySelectorAll<HTMLButtonElement>('[data-program-preview-toggle][aria-expanded="true"]')
        .forEach((openToggle) => {
          if (openToggle !== toggle) setProgramPreviewExpanded(openToggle, false);
        });
      setProgramPreviewExpanded(toggle, shouldExpand);
    });
  });
</script>

<style>
  .program-entry {
    position: relative;
  }

  .program-entry[data-live="true"]::before {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 4px;
    border-radius: 0.5rem 0 0 0.5rem;
    background: var(--color-primary);
    content: '';
    pointer-events: none;
  }

  .program-entry[data-deep-link-highlight="true"] {
    background: color-mix(in srgb, var(--color-primary) 9%, white);
    box-shadow: inset 4px 0 0 var(--color-primary);
  }

  .program-entry[data-favorite="true"] {
    background: color-mix(in srgb, var(--color-primary) 5%, white);
  }

  .program-entry[data-favorite="true"] .program-favorite-star {
    display: inline-flex;
  }

  .program-entry[data-favorite="true"]:hover {
    background: color-mix(in srgb, var(--color-primary) 7%, var(--color-bg));
  }

  .program-entry[data-deep-link-highlight="true"][data-favorite="true"] {
    background: color-mix(in srgb, var(--color-primary) 10%, white);
    box-shadow: inset 4px 0 0 var(--color-primary);
  }

  .program-entry:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .program-entry-preview-description {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }

  @media (min-width: 1024px) {
    .program-list-entries {
      border-top: 1px solid color-mix(in srgb, var(--color-dark) 10%, transparent);
    }

    .program-list-entries > .program-entry {
      border-color: color-mix(in srgb, var(--color-dark) 10%, transparent);
    }
  }

  @media (max-width: 639px) {
    :global(.program-entry-category.chip) {
      gap: 0.35em;
      padding: 0.2em 0.65em;
      border-color: color-mix(in srgb, var(--color-border) 82%, var(--color-dark));
      color: color-mix(in srgb, var(--color-dark) 88%, var(--color-white));
      font-size: 0.8125rem;
      letter-spacing: 0.035em;
      line-height: 1.2;
    }

    :global(.program-entry-category.chip .chip__dot) {
      width: 7px;
      height: 7px;
    }
  }
</style>
