---
import { type CollectionEntry } from 'astro:content';
import { type ScheduleEntry } from '../../../utils/schedule';

type GridCell =
  | { kind: 'entry'; entry: ScheduleEntry; rowspan: number }
  | { kind: 'empty' }
  | { kind: 'spanned' };

type TableGrid = {
  locations: CollectionEntry<'locations'>[];
  rows: { timeStr: string; isoTime: string; cells: Record<string, GridCell> }[];
};

interface Props {
  grid: TableGrid;
  artistMap: Record<string, CollectionEntry<'artists'>>;
  categoryMap: Record<string, string>;
  basePath: string;
  locale: 'de' | 'en';
}

const { grid, artistMap, categoryMap, basePath, locale } = Astro.props;

/** Fixe Zeilenhöhe in px. 1 Slot (30 min) = 1 Reihe = ROW_H px. */
const ROW_H = 48;
const TIME_COL_W = 72;
const LOCATION_COL_W = 120;
const tableMinWidth = `${TIME_COL_W + grid.locations.length * LOCATION_COL_W}px`;
---

<div data-view-panel="table" class="hidden overflow-x-auto -mx-4 sm:mx-0">
  <table class="w-full table-fixed border-collapse text-sm" style={`min-width: ${tableMinWidth};`}>
    <colgroup>
      <col class="w-14" />
      {grid.locations.map((loc) => (
        <col data-col-id={loc.data.location_id} />
      ))}
    </colgroup>
    <thead>
      <tr class="border-b-2 border-dark/20">
        <th class="text-left py-2 px-1.5 font-display text-dark/60 w-14">
          {locale === 'de' ? 'Zeit' : 'Time'}
        </th>
        {grid.locations.map((loc) => (
          <th class="text-left py-2 px-1.5 font-display text-dark text-sm overflow-hidden" title={loc.data.description} data-col-id={loc.data.location_id}>
            <span set:html={loc.data.description.replace(/\//g, '/<wbr>')} />
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {grid.rows.map((row) => (
        <tr
          class="table-row border-b border-gray-100 hover:bg-bg/60 transition-colors h-12"
          data-time-start={row.isoTime}
        >
          <td class="py-2 px-1.5 font-mono text-xs text-dark/50 align-top whitespace-nowrap">
            <span class="flex items-center gap-1">
              {row.timeStr}
              <span
                class="live-dot hidden w-2 h-2 rounded-full bg-primary animate-pulse"
                aria-hidden="true"
              />
            </span>
          </td>
          {grid.locations.map((loc) => {
            const cell = row.cells[loc.data.location_id];
            if (!cell || cell.kind === 'spanned') return null;
            if (cell.kind === 'empty') return <td class="py-2 px-1.5 align-top" data-col-id={loc.data.location_id} />;
            const { entry, rowspan } = cell;
            const artist = artistMap[entry.artist_id];
            const cat = categoryMap[entry.artist_id] ?? '';
            const isOrg = artist?.data.organizational ?? false;
            const catColorVar = cat ? `var(--color-cat-${cat})` : 'var(--color-bg-light)';
            // Innere Div-Höhe = rowspan × ROW_H − vertikale td-Padding (py-1.5 = 6px × 2 = 12px)
            const divHeight = rowspan * ROW_H - 12;
            return (
              <td
                rowspan={rowspan > 1 ? rowspan : undefined}
                class="py-1.5 px-1.5 align-top"
                data-location={entry.location_id}
                data-category={cat}
                data-col-id={loc.data.location_id}
              >
                <div
                  class="program-grid-entry relative rounded px-1 py-1 text-xs leading-tight overflow-hidden"
                  style={`height: ${divHeight}px; border-left: 3px solid ${catColorVar}; background: color-mix(in srgb, ${catColorVar} 12%, white);`}
                  lang={locale}
                >
                  {isOrg ? (
                    <span class="program-grid-entry__title text-dark/70">
                      {artist?.data.name ?? entry.artist_id}
                    </span>
                  ) : (
                    <a
                      href={`${basePath}/artists/${artist?.id ?? entry.artist_id}/`}
                      class="program-grid-entry__title font-semibold text-dark hover:text-primary transition-colors after:absolute after:inset-0"
                    >
                      {artist?.data.name ?? entry.artist_id}
                    </a>
                  )}
                </div>
              </td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .program-grid-entry__title {
    display: block;
    white-space: normal;
    word-break: normal;
    overflow-wrap: break-word;
    hyphens: auto;
  }
</style>
