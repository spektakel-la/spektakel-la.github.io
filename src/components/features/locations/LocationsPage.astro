---
/**
 * LocationsPage – Spielorte-Übersicht mit interaktiver Karte + Venue-Panel.
 *
 * Layout nach Mockup:
 *   Desktop: Linke Spalte (Venue-Liste / Panel, 340px) + rechts Karte
 *   Mobile:  Vollbild-Karte mit "Liste anzeigen"-Toggle; Panel als Overlay
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import { festival } from '../../../data/festival';
import { useTranslations } from '../../../i18n/utils';
import { loadSchedule, mergeConsecutiveSlots } from '../../../utils/schedule';
import { ROUTES } from '../../../utils/routes';
import { createFestivalLocationPlace, createPlace } from '../../../utils/jsonLd';
import { formatLocationLabel } from '../../../utils/locations';
import Page from '../../../layouts/Page.astro';
import PaintSplatter from '../../ui/PaintSplatter.astro';
import Picture from '../../ui/Picture.astro';
import LocationMap, { type MapLocation, type MapEntry } from './LocationMap.astro';

interface Props {
  locale: 'de' | 'en';
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const basePath = locale === 'en' ? '/en' : '';
const festivalLiveStart = festival.liveStart;
const festivalLiveEnd = festival.liveEnd;

const allLocations: CollectionEntry<'locations'>[] = await getCollection('locations');
const allArtists: CollectionEntry<'artists'>[] = await getCollection('artists');
const schedule = loadSchedule();
const artistMap = Object.fromEntries(allArtists.map((a) => [a.data.artist_id, a]));

const sortedLocations = [...allLocations].sort(
  (a, b) => (a.data.sort_order ?? 99) - (b.data.sort_order ?? 99)
);

const mapLocations: MapLocation[] = sortedLocations.map((loc) => {
  const locId = loc.data.location_id;
  const merged = mergeConsecutiveSlots(schedule.filter((e) => e.location_id === locId));

  const entries: MapEntry[] = merged.map((e) => {
    const artist = artistMap[e.artist_id];
    return {
      time: e.startTime.toISOString(),
      endTime: e.endTime.toISOString(),
      artistId: e.artist_id,
      artistName: (artist?.data as any)?.short_name ?? artist?.data.name ?? e.artist_id,
      artistSlug: e.artist_id,
      isOrganizational: artist?.data.organizational ?? false,
      festivalDay: e.festivalDay,
    } satisfies MapEntry;
  });

  return {
    id: locId,
    description: loc.data.description,
    displayLabel: formatLocationLabel(locId, loc.data.description, loc.data.location_label),
    gps: loc.data.gps,
    color: loc.data.marker_color,
    label: loc.data.location_label ?? locId,
    entries,
  } satisfies MapLocation;
});

const venueList = sortedLocations.filter((l) => !l.data.organizational);
const locationsUrl = `${festival.siteUrl}${basePath}${ROUTES.locations}`;
const festivalLocationPlace = createFestivalLocationPlace(locationsUrl);
const locationsJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${locationsUrl}#venues`,
  name: locale === 'en' ? 'Spektakel Landshut venues' : 'Spielorte Spektakel Landshut',
  url: locationsUrl,
  itemListElement: venueList.map((location, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      ...createPlace(location.data.description, location.data.gps, {
        id: `${locationsUrl}#venue-${location.data.location_id}`,
        url: `${locationsUrl}#venue-${location.data.location_id}`,
        containedInPlace: festivalLocationPlace,
      }),
      identifier: location.data.location_id,
    },
  })),
};
---

<Page locale={locale} title={t.locations.title} description={t.locations.tagline}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(locationsJsonLd)} />

  <!-- Haupt-Layout: vollbreite Karte -->
  <div id="locations-layout" class="relative" style="height: clamp(500px, 75vh, 800px);">

    <!-- Karte (vollbreite) -->
    <div class="w-full h-full relative">
      <LocationMap locations={mapLocations} lang={locale} />
    </div>

    <!-- Desktop: Venue-Panel als Overlay -->
    <div id="venue-panel-overlay" class="hidden absolute top-4 right-4 z-[500] w-80 max-h-[calc(100%-2rem)] bg-white rounded-xl shadow-xl flex-col overflow-hidden">
      <div class="flex items-center justify-end px-4 py-3 border-b-2 border-[var(--color-primary)] bg-white">
        <button id="panel-close-btn" aria-label="Schließen" class="text-2xl leading-none text-gray-400 hover:text-gray-700">×</button>
      </div>
      <div id="venue-panel-content" class="flex-1 overflow-y-auto px-4 py-4"></div>
    </div>

  </div>

  <!-- Mobile: "Liste anzeigen"-Button (unterhalb der Karte) -->
  <div class="md:hidden flex justify-center py-4 bg-white border-t border-gray-100">
    <button
      id="mobile-list-btn"
      class="px-5 py-2.5 bg-white shadow-md rounded-full font-semibold text-sm text-[var(--color-dark)] border border-gray-200 flex items-center gap-2"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <rect x="2" y="3" width="12" height="1.5" rx=".75" fill="currentColor"/>
        <rect x="2" y="7" width="12" height="1.5" rx=".75" fill="currentColor"/>
        <rect x="2" y="11" width="12" height="1.5" rx=".75" fill="currentColor"/>
      </svg>
      {t.locations.showList}
    </button>
  </div>

  <!-- Mobile Overlay: Venue-Liste -->
  <div id="mobile-overlay" class="md:hidden fixed inset-0 z-[2000] bg-white flex-col hidden" style="top:0">
    <div class="flex items-center justify-between px-4 py-3 border-b border-gray-200">
      <span class="font-bold text-lg uppercase tracking-wide">{t.locations.title}</span>
      <button id="mobile-close-btn" class="text-2xl text-gray-400">×</button>
    </div>
    <ul class="flex-1 overflow-y-auto">
      {venueList.map((loc) => (
        <li>
          <button
            id={`venue-${loc.data.location_id}`}
            data-venue-id={loc.data.location_id}
            class="venue-list-btn w-full flex items-center gap-3 px-4 py-4 hover:bg-gray-50 text-left border-b border-gray-100"
          >
            <Picture src={`/assets/img/map/marker-${loc.data.marker_color}.webp`} alt="" ariaHidden="true" width="24" height="32" class="flex-shrink-0" />
            <span class="font-semibold text-sm text-[var(--color-dark)]">
              {formatLocationLabel(loc.data.location_id, loc.data.description, loc.data.location_label)}
            </span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <!-- Mobile Overlay: Venue-Panel -->
  <div id="mobile-panel-overlay" class="md:hidden fixed inset-0 z-[2100] bg-white flex-col hidden" style="top:0">
    <div class="flex items-center justify-end px-4 py-3 border-b-2 border-[var(--color-primary)] sticky top-0 bg-white z-10">
      <button id="mobile-panel-close" class="text-2xl text-gray-400">×</button>
    </div>
    <div id="mobile-panel-content" class="flex-1 overflow-y-auto px-4 py-4"></div>
  </div>

  <!-- Legende (nur Desktop) -->
  <section class="hidden md:block bg-white border-t border-gray-100 py-4">
    <div class="container mx-auto px-4 flex flex-wrap gap-3 items-center">
      {venueList.map((loc) => (
        <button
          data-venue-id={loc.data.location_id}
          class="venue-list-btn inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gray-50 border border-gray-200 text-xs font-medium hover:border-[var(--color-primary)] transition-colors"
        >
          <Picture src={`/assets/img/map/marker-${loc.data.marker_color}.webp`} alt="" ariaHidden="true" width="14" height="18" />
          {formatLocationLabel(loc.data.location_id, loc.data.description, loc.data.location_label)}
        </button>
      ))}
    </div>
  </section>
</Page>

<script define:vars={{ festivalLiveStart, festivalLiveEnd }}>
  const FESTIVAL_START = new Date(festivalLiveStart).getTime();
  const FESTIVAL_END   = new Date(festivalLiveEnd).getTime();
  const THREE_HOURS    = 3 * 60 * 60 * 1000;

  function fmt(iso) {
    return new Date(iso).toLocaleTimeString('de-DE', {
      hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Berlin',
    });
  }

  function getDayLabel(dayStr, lang) {
    return new Date(dayStr + 'T12:00:00').toLocaleDateString(
      lang === 'en' ? 'en-GB' : 'de-DE',
      { weekday: 'long', day: '2-digit', month: '2-digit' }
    );
  }

  function entryHtml(e, basePath) {
    const time = `${fmt(e.time)} – ${fmt(e.endTime)}`;
    const nameHtml = e.isOrganizational
      ? `<span class="italic text-gray-400 text-sm">${e.artistName}</span>`
      : `<a href="${basePath}/artists/${e.artistSlug}/" class="font-semibold text-[var(--color-dark)] hover:text-[var(--color-primary)] transition-colors text-sm">${e.artistName}</a>`;
    return `<div class="py-2 border-b border-gray-100 last:border-0">
      <span class="text-xs text-gray-400 tabular-nums block">${time}</span>
      ${nameHtml}
    </div>`;
  }

  function buildPanelContent(loc, lang) {
    const now = Date.now();
    const duringFestival = now >= FESTIVAL_START && now <= FESTIVAL_END;
    const basePath = lang === 'en' ? '/en' : '';
    const allEntries = loc.entries ?? [];

    let html = `<h2 class="font-display text-2xl uppercase tracking-wide text-[var(--color-dark)] mb-4 leading-tight">${loc.displayLabel}</h2>`;

    if (duringFestival) {
      const current  = allEntries.filter((e) => new Date(e.time).getTime() <= now && new Date(e.endTime).getTime() > now);
      const upcoming = allEntries.filter((e) => new Date(e.time).getTime() > now && new Date(e.time).getTime() <= now + THREE_HOURS);

      if (current.length > 0) {
        html += `<div class="mb-5">
          <p class="text-xs uppercase tracking-widest font-semibold text-[var(--color-primary)] mb-2">${lang === 'en' ? 'Now' : 'Jetzt'}</p>
          ${current.map((e) => entryHtml(e, basePath)).join('')}
        </div>`;
      }
      if (upcoming.length > 0) {
        html += `<div class="mb-5">
          <p class="text-xs uppercase tracking-widest font-semibold text-gray-400 mb-2">${lang === 'en' ? 'Next 3 hours' : 'Nächste 3 Stunden'}</p>
          ${upcoming.map((e) => entryHtml(e, basePath)).join('')}
        </div>`;
      }
      if (current.length === 0 && upcoming.length === 0) {
        html += `<p class="text-gray-400 italic text-sm mb-4">${lang === 'en' ? 'No programme right now.' : 'Gerade kein Programm.'}</p>`;
      }
    } else {
      // Außerhalb Festival: alle Einträge nach Tag
      if (allEntries.length === 0) {
        html += `<p class="text-gray-400 italic text-sm mb-4">${lang === 'en' ? 'No programme scheduled.' : 'Kein Programm geplant.'}</p>`;
      } else {
        const byDay = {};
        allEntries.forEach((e) => { (byDay[e.festivalDay] ??= []).push(e); });
        html += Object.keys(byDay).sort().map((day) =>
          `<div class="mb-5">
            <p class="text-xs uppercase tracking-widest font-semibold text-gray-400 mb-2">${getDayLabel(day, lang)}</p>
            ${byDay[day].map((e) => entryHtml(e, basePath)).join('')}
          </div>`
        ).join('');
      }
    }

    return html;
  }

  function openPanel(loc, lang) {
    const content = buildPanelContent(loc, lang);
    if (window.innerWidth < 768) {
      const overlay = document.getElementById('mobile-panel-overlay');
      const contentEl = document.getElementById('mobile-panel-content');
      if (!overlay || !contentEl) return;
      contentEl.innerHTML = content;
      overlay.classList.remove('hidden'); overlay.classList.add('flex');
      document.getElementById('mobile-overlay')?.classList.add('hidden');
      document.getElementById('mobile-overlay')?.classList.remove('flex');
    } else {
      const overlay   = document.getElementById('venue-panel-overlay');
      const contentEl = document.getElementById('venue-panel-content');
      if (!overlay || !contentEl) return;
      contentEl.innerHTML = content;
      overlay.classList.remove('hidden'); overlay.classList.add('flex');
    }
  }

  function closePanel() {
    window.spektakel?.analytics?.track('venue_panel_closed');
    document.dispatchEvent(new CustomEvent('venue-closed'));
    history.replaceState(null, '', ' ');
    const overlay = document.getElementById('venue-panel-overlay');
    overlay?.classList.add('hidden'); overlay?.classList.remove('flex');
    const mobilePanel = document.getElementById('mobile-panel-overlay');
    if (mobilePanel && !mobilePanel.classList.contains('hidden')) {
      mobilePanel.classList.add('hidden'); mobilePanel.classList.remove('flex');
      // Zurück zur textuellen Liste (wenn sie zuvor geöffnet war)
      const mobileList = document.getElementById('mobile-overlay');
      mobileList?.classList.remove('hidden'); mobileList?.classList.add('flex');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const lang = document.documentElement.lang || 'de';

    // Karte → Panel
    document.addEventListener('venue-selected', (e) => {
      const loc = e.detail;
      openPanel(loc, lang);
      window.spektakel?.analytics?.track('venue_selected', {
        venue_id: loc.id,
        venue_name: loc.description,
        source: loc.source ?? 'map',
        entries_count: loc.entries?.length ?? 0,
      });
    });

    // Desktop Panel-Buttons
    document.getElementById('panel-close-btn')?.addEventListener('click', closePanel);

    // Mobile Overlay-Buttons
    document.getElementById('mobile-list-btn')?.addEventListener('click', () => {
      const overlay = document.getElementById('mobile-overlay');
      overlay?.classList.remove('hidden'); overlay?.classList.add('flex');
      window.spektakel?.analytics?.track('mobile_venue_list_opened');
    });
    document.getElementById('mobile-close-btn')?.addEventListener('click', () => {
      const overlay = document.getElementById('mobile-overlay');
      overlay?.classList.add('hidden'); overlay?.classList.remove('flex');
    });
    document.getElementById('mobile-panel-close')?.addEventListener('click', closePanel);

    // Venue-Listen-Buttons (Sidebar + Mobile-Liste + Legende)
    document.querySelectorAll('.venue-list-btn[data-venue-id]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const venueId = btn.dataset.venueId;
        const mapDataEl = document.getElementById('spektakel-map-data');
        if (!mapDataEl || !venueId) return;
        const loc = JSON.parse(mapDataEl.textContent || '[]').find((l) => l.id === venueId);
        if (loc) {
          openPanel(loc, lang);
          history.replaceState(null, '', `#${venueId}`);
          window.spektakel?.analytics?.track('venue_selected', {
            venue_id: loc.id,
            venue_name: loc.description,
            source: 'list',
            entries_count: loc.entries?.length ?? 0,
          });
        }
      });
    });
  });
</script>
