---
import { getCollection } from 'astro:content';
import type { Locale } from '../../../i18n/utils';
import { useTranslations } from '../../../i18n/utils';
import Page from '../../../layouts/Page.astro';
import PageHero from '../../layout/PageHero.astro';
import PaintSplatter from '../../ui/PaintSplatter.astro';
import Picture from '../../ui/Picture.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const t = useTranslations(locale);
const sponsors = (await getCollection('sponsors')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, locale),
);
---

<Page
  title={t.sponsors.title}
  description={t.sponsors.tagline}
  locale={locale}
>
  <PageHero eyebrow="SPEKTAKEL LANDSHUT" title={t.sponsors.title} subtitle={t.sponsors.tagline}>
    <div slot="decor">
      <div class="absolute -right-12 -top-36 w-96 opacity-70 sm:right-0">
        <PaintSplatter variant={3} width={420} />
      </div>
    </div>
  </PageHero>

  <section class="bg-white py-10 sm:py-14">
    <div class="mx-auto max-w-7xl px-6">
      <ul class="m-0 grid list-none grid-cols-2 gap-4 p-0 sm:grid-cols-3 sm:gap-6 lg:grid-cols-4">
        {sponsors.map(({ data }) => (
          <li class="min-w-0">
            {data.url ? (
              <a
                href={data.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${t.sponsors.visit} ${data.name}`}
                class="flex h-36 items-center justify-center rounded-xl border border-dark/10 bg-white p-5 shadow-sm transition duration-200 hover:border-primary/40 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary sm:h-44 sm:p-8"
              >
                <Picture
                  src={data.logo}
                  alt={data.name}
                  width="320"
                  height="160"
                  loading="lazy"
                  decoding="async"
                  class="max-h-20 w-full object-contain sm:max-h-24"
                />
              </a>
            ) : (
              <div class="flex h-36 items-center justify-center rounded-xl border border-dark/10 bg-white p-5 shadow-sm sm:h-44 sm:p-8">
                <Picture
                  src={data.logo}
                  alt={data.name}
                  width="320"
                  height="160"
                  loading="lazy"
                  decoding="async"
                  class="max-h-20 w-full object-contain sm:max-h-24"
                />
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
</Page>
