---
import { useTranslations } from '../../../i18n/utils';

interface Props {
  locale?: string;
}

const { locale = 'de' } = Astro.props;
const t = useTranslations(locale);
---

<aside
  class="cookie-banner"
  data-cookie-banner
  aria-labelledby="cookie-banner-title"
  aria-describedby="cookie-banner-description"
  hidden
>
  <div class="cookie-banner__content">
    <div class="cookie-banner__copy">
      <p class="cookie-banner__eyebrow">{t.cookie.eyebrow}</p>
      <h2 id="cookie-banner-title">{t.cookie.title}</h2>
      <p id="cookie-banner-description">{t.cookie.message}</p>
      <details>
        <summary>{t.cookie.details}</summary>
        <p>{t.cookie.detailText}</p>
      </details>
    </div>

    <div class="cookie-banner__actions">
      <button type="button" class="cookie-banner__button cookie-banner__button--accept" data-consent="accepted">
        {t.cookie.accept}
      </button>
      <button type="button" class="cookie-banner__button cookie-banner__button--decline" data-consent="declined">
        {t.cookie.decline}
      </button>
    </div>
  </div>
</aside>

<script is:inline>
  (() => {
    const banner = document.querySelector('[data-cookie-banner]');
    if (!(banner instanceof HTMLElement)) return;

    const consent = window.spektakel?.consent;
    if (!consent || consent.getStatus() === 'pending') {
      banner.hidden = false;
    }

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      if (target.closest('[data-cookie-settings]')) {
        banner.hidden = false;
        banner.querySelector('button')?.focus();
        return;
      }

      const button = target.closest('[data-consent]');
      if (!(button instanceof HTMLButtonElement)) return;

      const choice = button.dataset.consent;
      if (choice !== 'accepted' && choice !== 'declined') return;

      const previousChoice = consent?.getStatus();
      consent?.setStatus(choice);
      banner.hidden = true;

      // Bereits geladenes Analytics wird durch einen Reload sicher beendet.
      if (previousChoice === 'accepted' && choice === 'declined') {
        window.location.reload();
      }
    });
  })();
</script>

<style>
  .cookie-banner {
    position: fixed;
    z-index: var(--z-modal);
    right: var(--space-6);
    bottom: var(--space-6);
    width: min(42rem, calc(100vw - 2 * var(--space-6)));
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-white);
    color: var(--color-dark);
    box-shadow: var(--shadow-lg);
  }

  .cookie-banner[hidden] { display: none; }

  .cookie-banner__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-6);
    align-items: end;
    padding: var(--space-6);
  }

  .cookie-banner__eyebrow {
    margin: 0 0 var(--space-1);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 400;
    line-height: var(--leading-tight);
    text-transform: uppercase;
  }

  .cookie-banner__copy > p:not(.cookie-banner__eyebrow), details p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  details { margin-top: var(--space-3); }

  summary {
    width: fit-content;
    cursor: pointer;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  details p { margin-top: var(--space-2); color: var(--color-text-muted); }

  .cookie-banner__actions { display: flex; flex-direction: column; gap: var(--space-2); }

  .cookie-banner__button {
    min-width: 8.5rem;
    border: 2px solid var(--color-dark);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-5);
    font: 700 var(--text-sm)/1 var(--font-body);
    cursor: pointer;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .cookie-banner__button:hover { transform: translate(-2px, -2px); box-shadow: 3px 3px 0 var(--color-dark); }
  .cookie-banner__button:focus-visible { outline: 3px solid var(--color-cyan); outline-offset: 3px; }
  .cookie-banner__button--accept { background: var(--color-primary); color: var(--color-white); }
  .cookie-banner__button--decline { background: var(--color-white); color: var(--color-dark); }

  @media (max-width: 40rem) {
    .cookie-banner {
      right: var(--space-4);
      bottom: var(--space-4);
      width: calc(100vw - 2 * var(--space-4));
    }

    .cookie-banner__content { grid-template-columns: 1fr; gap: var(--space-4); padding: var(--space-5); }
    .cookie-banner__actions { flex-direction: row; }
    .cookie-banner__button { flex: 1; min-width: 0; padding-inline: var(--space-3); }
  }
</style>
