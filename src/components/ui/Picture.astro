---
import { getImageVariants } from '../../utils/imageVariants';

interface Props {
  src: string;
  alt: string;
  width?: string | number;
  height?: string | number;
  loading?: 'eager' | 'lazy';
  decoding?: 'async' | 'auto' | 'sync';
  class?: string;
  style?: string;
  ariaHidden?: boolean | 'true' | 'false';
}

const {
  src,
  alt,
  width,
  height,
  loading,
  decoding,
  class: className,
  style,
  ariaHidden,
} = Astro.props;
const image = getImageVariants(src);
---

<img
  src={image.src}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  decoding={decoding}
  class={className}
  style={style}
  aria-hidden={ariaHidden}
/>
