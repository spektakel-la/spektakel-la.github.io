---
import { type Category, CATEGORY_COLORS } from '../../utils/categories';
/**
 * CategoryChip – Filter-Chip für Kategorie-Auswahl.
 *
 * Aktiver Chip: Magenta gefüllt.
 * Inaktiver Chip: Grauer Rahmen, optionaler Farbpunkt.
 *
 * Kann als <button> (onClick) oder als <a> (href) gerendert werden.
 * Für rein dekorative Nutzung: `class="pointer-events-none"` übergeben.
 *
 * Farben kommen aus `CATEGORY_COLORS` in `src/utils/categories.ts`.
 */

interface Props {
  /** Kategorie-Key – steuert den Farbpunkt. Leer = „Alle"-Chip */
  category?: Category;
  /** Angezeigter Text */
  label: string;
  /** Chip ist gerade aktiv/ausgewählt */
  active?: boolean;
  href?: string;
  /** Wird nur für <button>-Chips benötigt */
  'data-category'?: Category | '';
  class?: string;
}

const {
  category,
  label,
  active = false,
  href,
  class: className,
  'data-category': dataCategory,
} = Astro.props;

const dotColor = category ? (CATEGORY_COLORS[category] ?? null) : null;
---

{href ? (
  <a
    href={href}
    class:list={['chip', active && 'chip--active', className]}
    aria-current={active ? 'true' : undefined}
  >
    {dotColor && <span class="chip__dot" style={`background-color: ${dotColor};`} aria-hidden="true" />}
    {label}
  </a>
) : (
  <button
    type="button"
    data-category={dataCategory ?? category}
    class:list={['chip', active && 'chip--active', className]}
    aria-pressed={active ? 'true' : 'false'}
  >
    {dotColor && <span class="chip__dot" style={`background-color: ${dotColor};`} aria-hidden="true" />}
    {label}
  </button>
)}

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.35em 0.9em;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    border: 1.5px solid var(--color-border);
    background-color: transparent;
    color: var(--color-text);
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    line-height: 1.4;
  }

  .chip:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .chip--active {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }

  .chip--active:hover {
    background-color: #e0205f;
    border-color: #e0205f;
    color: #fff;
  }

  .chip--active .chip__dot {
    /* Dot bleibt sichtbar auf dunklem Hintergrund, leicht aufgehellt */
    opacity: 0.9;
  }

  .chip__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
</style>
