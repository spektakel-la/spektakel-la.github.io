---
/**
 * MapPin – Wiederverwendbarer Karten-Pin.
 *
 * Wird auf der Künstler-Detailseite (Spielzeiten) und später
 * in der Leaflet-Karte (als HTML-Marker-Icon) genutzt.
 *
 * Beispiel:
 *   <MapPin color="green" size={14} />
 *   <MapPin color="#FF2D7A" size={20} />
 */

interface Props {
  /** CSS-Farbe (Name oder Hex). Standard: var(--color-primary) */
  color?: string;
  /** Größe in px. Standard: 16 */
  size?: number;
  class?: string;
}

const { color = 'var(--color-primary)', size = 16, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={color}
  aria-hidden="true"
  class={className}
>
  <path
    fill-rule="evenodd"
    d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-2.079 3.953-5.158 3.953-8.833 0-4.667-3.805-8.25-8.25-8.25S3.75 7.783 3.75 12.25c0 3.675 2.009 6.754 3.953 8.833a19.58 19.58 0 002.683 2.282 16.975 16.975 0 001.144.742l.07.04zM12 15.75a3.75 3.75 0 100-7.5 3.75 3.75 0 000 7.5z"
    clip-rule="evenodd"
  />
</svg>
