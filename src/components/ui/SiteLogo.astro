---
interface Props {
  variant?: 'header' | 'footer';
}

const { variant = 'header' } = Astro.props;
---

<span class:list={['site-logo', `site-logo--${variant}`]} aria-hidden="true">
  <span>Spektakel</span>
  <span>Landshut</span>
</span>

<style>
  .site-logo {
    --site-logo-landshut-scale: 1.096;

    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    color: currentColor;
    font-family: 'Garnois', var(--font-display);
    font-weight: 400;
    line-height: 0.78;
    letter-spacing: 0.015em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .site-logo span {
    display: block;
    transform-origin: left center;
  }

  .site-logo span + span {
    transform: scaleX(var(--site-logo-landshut-scale));
  }

  .site-logo--header {
    color: var(--color-dark);
    font-size: clamp(1.55rem, 4.8vw, 2.18rem);
  }

  .site-logo--footer {
    color: var(--color-primary);
    font-size: clamp(2.15rem, 8vw, 3.35rem);
    text-shadow:
      0.04em 0 var(--color-dark),
      0 0.04em var(--color-dark),
      -0.04em 0 var(--color-dark),
      0 -0.04em var(--color-dark);
  }
</style>
