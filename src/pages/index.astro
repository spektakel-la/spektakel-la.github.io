---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import PaintSplatter from '../components/ui/PaintSplatter.astro';
import Picture from '../components/ui/Picture.astro';
import { festival } from '../data/festival';
import { localePath, useTranslations, type Locale } from '../i18n/utils';
import Page from '../layouts/Page.astro';
import { imagePositionToObjectPosition } from '../utils/imagePosition';
import { preferWebp } from '../utils/imageVariants';
import { createFestivalEvent, createOffer, createOrganizer, createPlace } from '../utils/jsonLd';
import { artistPath, ROUTES } from '../utils/routes';
import { formatTime, getFestivalDays, groupByDay, loadSchedule, mergeConsecutiveSlots } from '../utils/schedule';

// ─── Assets ────────────────────────────────────────────────────────────────
import heroImg from '../assets/hero/hero2.webp';
import hatImg from '../assets/hat/hat.webp';

const locale: Locale = Astro.url.pathname.startsWith('/en') ? 'en' : 'de';
const t = useTranslations(locale);
const localize = (path: string) => localePath(path, locale);
const meta = locale === 'en'
  ? {
      title: 'Spektakel Landshut – 20th international street art festival',
      description: 'The 20th international street art festival in Landshut: acrobatics, juggling, music, comedy and street art in the historic city centre.',
      accessibleTitle: 'Spektakel Landshut – 20th international street art festival',
      heroTop: '20TH INTERNATIONAL',
      heroMiddle: 'STREET ART',
      heroBottom: 'FESTIVAL',
      hatBadge: ['ARTISTS', 'PERFORM FOR', 'YOUR TIPS!'],
    }
  : {
      title: 'Spektakel Landshut – 20. internationales Straßenkunstfestival',
      description: 'Das 20. internationale Straßenkunst-Festival in Landshut: Akrobatik, Jonglage, Musik, Comedy und Street Art mitten in der Altstadt.',
      accessibleTitle: 'Spektakel Landshut – 20. internationales Straßenkunstfestival',
      heroTop: '20. INTERNATIONALES',
      heroMiddle: 'STRASSENKUNST',
      heroBottom: 'FESTIVAL',
      hatBadge: ['KÜNSTLER', 'SPIELEN FÜR', 'DEN HUT!'],
    };

// ─── Featured Artists ──────────────────────────────────────────────────────
const allArtists: CollectionEntry<'artists'>[] = await getCollection('artists');
const allLocations: CollectionEntry<'locations'>[] = await getCollection('locations');
const artistsWithImages = allArtists.filter(
  (artist) => !artist.data.organizational && (artist.data.images?.length ?? 0) > 0,
);
const featuredArtists = artistsWithImages;

// ─── Spielplan-Vorschau ────────────────────────────────────────────────────
const schedule = loadSchedule();
const days = getFestivalDays(schedule);
const byDay = groupByDay(schedule);
const previewDay = days[0] ?? '';
const previewEntries = (byDay[previewDay] ?? [])
  .filter(e => !e.artist_id.startsWith('organization_'))
  .slice(0, 5);
const artistMap = Object.fromEntries(allArtists.map(a => [a.data.artist_id, a]));
const locationMap = Object.fromEntries(allLocations.map(location => [location.data.location_id, location]));
const publicScheduleEntries = schedule.filter(entry => {
  const artist = artistMap[entry.artist_id];
  return artist && !artist.data.organizational && locationMap[entry.location_id];
});
const showProgramCta = publicScheduleEntries.length > 0;

// ─── Structured Data ──────────────────────────────────────────────────────
const siteUrl = festival.siteUrl;
const homeUrl = locale === 'en' ? `${siteUrl}/en/` : `${siteUrl}/`;
const programUrl = locale === 'en' ? `${siteUrl}/en/program/` : `${siteUrl}/program/`;
const publicPerformances = mergeConsecutiveSlots(publicScheduleEntries);
const festivalPerformers = featuredArtists.map(artist => ({
  '@type': 'PerformingGroup',
  name: artist.data.name,
  url: `${siteUrl}${locale === 'en' ? '/en' : ''}${artistPath(artist.data.artist_id)}`,
}));
const festivalJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Festival',
  name: festival.name,
  description: meta.description,
  startDate: publicPerformances[0]?.startTime.toISOString() ?? festival.startDate,
  endDate: publicPerformances.at(-1)?.endTime.toISOString() ?? festival.endDate,
  url: homeUrl,
  image: `${siteUrl}/assets/img/logo/logo.webp`,
  performer: festivalPerformers,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: createPlace(festival.locationName),
  organizer: createOrganizer(),
  offers: createOffer(programUrl),
  subEvent: publicPerformances.map(entry => {
    const artist = artistMap[entry.artist_id];
    const location = locationMap[entry.location_id];
    return createFestivalEvent({
      name: `${artist.data.name} – ${festival.organizerName}`,
      startDate: entry.startTime.toISOString(),
      endDate: entry.endTime.toISOString(),
      url: programUrl,
      image: artist.data.images?.[0] ? new URL(preferWebp(artist.data.images[0]), siteUrl).href : undefined,
      performer: { '@type': 'PerformingGroup', name: artist.data.name },
      location: {
        name: location.data.description,
        gps: location.data.gps,
      },
    });
  }),
};

const dayLabels: Record<string, string> = {
  '2026-09-18': locale === 'en' ? 'Friday, 18 September' : 'Freitag, 18. September',
  '2026-09-19': locale === 'en' ? 'Saturday, 19 September' : 'Samstag, 19. September',
  '2026-09-20': locale === 'en' ? 'Sunday, 20 September' : 'Sonntag, 20. September',
};

const announcementEvents = locale === 'en'
  ? [
      {
        date: 'Wednesday, 16 Sept.',
        time: '19:30',
        location: 'Rathaus Prunksaal',
        title: 'Preview: "The Picture of Dorian Gray"',
      },
      {
        date: 'Thursday, 17 Sept.',
        time: '20:00',
        location: 'Theaterzelt Landshut',
        title: 'BMW Spektakel Gala 2026',
        detail: 'Opening of the 20th Spektakel La.',
      },
      {
        date: 'Friday, 18 Sept. - Sunday, 20 Sept.',
        time: '',
        location: 'Rathaus Prunksaal, Salzstadel, Landtor and old town',
        title: 'Who will tweet their way to victory?',
        summary: 'Germany’s first bird-call imitation competition is looking for the best imitations of European wild birds.',
        detail: [
          'At Spektakel Landshut in September, people will chirp, whistle and warble: Germany’s first bird-call imitation competition is looking for the best imitators of bird voices.',
          'Whether blackbird, gull, cuckoo or owl - any European wild bird may be imitated, using only mouth and hands, with no aids.',
          'The competition takes place in two categories: children up to 12 years, and teenagers & adults from 12 years. A jury will judge the performances, with small prizes included. To take part, send your registration to dervogelphilipp@gmail.com. If there are still slots available, you can also show your imitation spontaneously on stage.',
        ],
      },
      {
        date: 'Friday, 18 Sept. - Sunday, 20 Sept.',
        time: '',
        location: 'Rathaus Prunksaal, Salzstadel, Landtor and old town',
        title: 'Spektakel Landshut',
        detail: 'More than 200 shows in three days ...',
      },
    ]
  : [
      {
        date: 'Mittwoch, 16. Sept.',
        time: '19:30',
        location: 'Rathaus Prunksaal',
        title: 'Vorpremiere „Das Bildnis des Dorian Gray"',
      },
      {
        date: 'Donnerstag, 17. Sept.',
        time: '20:00',
        location: 'Theaterzelt Landshut',
        title: 'BMW Spektakel Gala 2026',
        detail: 'Eröffnung 20. Spektakel La.',
      },
      {
        date: 'Freitag 18. Sept. – Sonntag 20. Sept.',
        time: '',
        location: 'Rathaus Prunksaal, Salzstadel, Ländtor und Altstadt',
        title: 'Wer zwitschert sich zum Sieg?',
        summary: 'Deutschlands erster Vogelstimmenimitationswettbewerb sucht die besten Imitationen europäischer Wildvögel.',
        detail: [
          'Beim Spektakel Landshut im September wird gezwitschert, gepfiffen und geträllert: Gesucht werden die besten Vogelstimmenimitatorinnen und -imitatoren bei Deutschlands erstem Vogelstimmenimitationswettbewerb.',
          'Ob Amsel, Möwe, Kuckuck oder Eule - jeder europäische Wildvogel darf imitiert werden, ausschließlich mit Mund und Händen, ohne Hilfsmittel.',
          'Der Wettbewerb findet in zwei Kategorien statt: Kinder bis 12 Jahre und Jugendliche & Erwachsene ab 12 Jahren. Eine Jury bewertet die Auftritte, kleine Preise inklusive. Wer teilnehmen möchte, schickt seine Anmeldung an dervogelphilipp@gmail.com. Falls noch Platz ist, kann man seine Imitation auch spontan vor Ort auf der Bühne zeigen.',
        ],
      },
      {
        date: 'Freitag 18. Sept. – Sonntag 20. Sept.',
        time: '',
        location: 'Rathaus Prunksaal, Salzstadel, Ländtor und Altstadt',
        title: 'Spektakel Landshut',
        detail: 'Über 200 Shows in drei Tagen ...',
      },
    ];
---

<Page
  title={meta.title}
  description={meta.description}
  locale={locale}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(festivalJsonLd)} />

  <!-- ═══ HERO ══════════════════════════════════════════════════════════════ -->
  <section class="relative min-h-[calc(100svh-4rem)] md:min-h-screen bg-white overflow-hidden flex items-start md:items-center">

    <!-- Mobile Artist-Moment: bringt die Desktop-Energie in den ersten Viewport -->
    <div
      class="absolute top-8 -right-28 w-[23rem] max-w-none opacity-16 md:hidden pointer-events-none select-none"
      style="-webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 68%, transparent 100%); mask-image: linear-gradient(to bottom, #000 0%, #000 68%, transparent 100%);"
      aria-hidden="true"
    >
      <Image
        src={heroImg}
        alt=""
        width={420}
        class="w-full h-auto object-contain"
        loading="eager"
      />
    </div>

    <!-- Haupt-Splatter hinter Künstler-Figur (Mitte-rechts) -->
    <div
      class="absolute top-[30rem] -right-36 w-[22rem] md:w-auto md:top-1/2 md:right-[10%] md:-translate-y-1/2 pointer-events-none opacity-50 md:opacity-80"
      aria-hidden="true"
    >
      <PaintSplatter variant={1} width={560} />
    </div>
    <!-- Kleiner Akzent-Splatter unten links -->
    <div
      class="hidden md:block absolute md:-bottom-10 md:left-16 pointer-events-none md:opacity-40"
      aria-hidden="true"
    >
      <PaintSplatter variant={4} width={260} />
    </div>

    <!-- Künstler-Figur (rechts, ab md) -->
    <div
      class="absolute right-0 bottom-0 hidden md:block h-full pointer-events-none select-none"
      aria-hidden="true"
    >
      <Image
        src={heroImg}
        alt=""
        width={540}
        class="h-[90%] w-auto object-contain object-bottom"
        loading="eager"
      />
    </div>

    <!-- Hut-Kreis-Badge (Desktop, über Künstler-Figur) -->
    <div
      class="absolute right-[24%] top-[52%] -translate-y-1/2 hidden md:flex items-center justify-center
             w-36 h-36 lg:w-44 lg:h-44 rounded-full bg-dark z-20 pointer-events-none"
      aria-hidden="true"
    >
      <p class="font-display text-white text-center leading-tight px-3 text-lg lg:text-xl">
        {meta.hatBadge.map((line, index) => <>{line}{index < meta.hatBadge.length - 1 && <br />}</>)}
      </p>
    </div>

    <!-- Seiten-Inhalt -->
    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 pt-36 pb-14 md:py-20 lg:py-28">
      <div class="max-w-xl">

        <!-- Barrierefreie h1 -->
        <h1 class="sr-only">{meta.accessibleTitle}</h1>

        <!-- Glas-Wrapper: passt sich nur der Text-Breite an, kein Card-Effekt -->
        <div class="w-fit px-4 pt-4 pb-5
                    md:bg-transparent md:backdrop-blur-none md:px-0 md:pt-0 md:pb-0 md:rounded-none">

          <!-- Visueller Headline-Block -->
          <p
            class="hero-title-line font-display leading-none text-dark"
            style="font-size: clamp(2.5rem, 7vw, 5.5rem)"
            aria-hidden="true"
          >{meta.heroTop}</p>
          <p
            class="hero-title-line font-display leading-none text-primary"
            style="font-size: clamp(2.5rem, 7vw, 5.5rem)"
            aria-hidden="true"
          >{meta.heroMiddle}</p>
          <p
            class="hero-title-line font-display leading-none text-dark mb-5"
            style="font-size: clamp(2.5rem, 7vw, 5.5rem)"
            aria-hidden="true"
          >{meta.heroBottom}</p>

          <!-- Datum -->
          <p class="font-display text-2xl text-dark mb-3">{t.home.hero_dates}</p>

          <!-- LANDSHUT-Badge -->
          <span class="inline-block bg-lime text-dark font-display text-xl px-4 py-1 mb-4 rounded-sm">
            LANDSHUT
          </span>

          <!-- Subtext -->
          <p class="text-dark/80 text-base sm:text-lg leading-relaxed max-w-[340px]">
            {t.home.hero_subtext}
          </p>

        </div>

        <!-- CTAs (außerhalb des Glas-Wrappers) -->
        <div class="flex flex-wrap gap-4 mt-8">
          {showProgramCta && (
            <Button href={localize(ROUTES.program)} variant="primary" size="lg">{t.home.cta_program}</Button>
          )}
          <Button href={localize(ROUTES.artists)} variant={showProgramCta ? 'ghost' : 'primary'} size="lg">
            {t.home.cta_artists}
          </Button>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══ ANKÜNDIGUNGEN ═════════════════════════════════════════════════════ -->
  <section id="aktuelles" class="relative overflow-hidden py-16 sm:py-24 bg-bg">
    <div class="absolute -right-20 top-8 hidden sm:block opacity-25 pointer-events-none" aria-hidden="true">
      <PaintSplatter variant={2} width={320} />
    </div>
    <div class="absolute -left-24 bottom-0 opacity-20 pointer-events-none" aria-hidden="true">
      <PaintSplatter variant={3} width={280} />
    </div>

    <div class="relative max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-[0.85fr_1.15fr] gap-10 lg:gap-16 items-start">
        <div>
          <h2 class="font-display text-5xl sm:text-6xl text-dark leading-tight">
            {t.home.announcements_heading}
          </h2>
          <p class="mt-5 text-dark/70 text-lg leading-relaxed max-w-md">
            {t.home.announcements_text}
          </p>
          <a
            href="mailto:stadtspektakel@gmail.com"
            class="inline-flex items-center gap-3 mt-8 bg-primary text-white font-display text-xl px-5 py-3 rounded-sm shadow-md hover:bg-dark transition-colors"
          >
            {t.home.announcements_contact}
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <ol class="grid gap-4 list-none p-0 m-0">
          {announcementEvents.map((event, index) => (
            <li class="relative overflow-hidden bg-white border border-dark/10 rounded-lg shadow-md">
              <div
                class:list={[
                  'absolute inset-y-0 left-0 w-2',
                  index === 0 && 'bg-primary',
                  index === 1 && 'bg-cyan',
                  index === 2 && 'bg-lime',
                  index === 3 && 'bg-primary',
                ]}
                aria-hidden="true"
              />
              <div class="p-5 sm:p-6 pl-7 sm:pl-8">
                <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4 mb-3">
                  <p class="font-display text-2xl sm:text-3xl text-dark leading-none">
                    {event.date}
                  </p>
                  {event.time && (
                    <p class="font-display text-xl text-primary leading-none tabular-nums">
                      {event.time}
                    </p>
                  )}
                </div>
                <p class="text-dark/55 text-sm font-semibold uppercase tracking-normal mb-2">
                  {event.location}
                </p>
                <h3 class="font-display text-3xl sm:text-4xl text-dark leading-tight">
                  {event.title}
                </h3>
                {event.summary && (
                  <p class="mt-2 text-dark/70 text-base sm:text-lg leading-relaxed">
                    {event.summary}
                  </p>
                )}
                {event.detail && (
                  Array.isArray(event.detail) ? (
                    <details class="group mt-3" data-stable-announcement-details>
                      <summary class="inline-flex cursor-pointer list-none items-center gap-2 font-semibold text-primary hover:text-dark transition-colors">
                        <span class="group-open:hidden">{locale === 'de' ? 'Mehr erfahren' : 'Read more'}</span>
                        <span class="hidden group-open:inline">{locale === 'de' ? 'Weniger anzeigen' : 'Show less'}</span>
                        <span aria-hidden="true" class="transition-transform group-open:rotate-180">↓</span>
                      </summary>
                      <div class="mt-3 space-y-3 text-dark/70 text-base sm:text-lg leading-relaxed">
                        {event.detail.map((paragraph) => (
                          <p>{paragraph}</p>
                        ))}
                      </div>
                    </details>
                  ) : (
                    <p class="mt-2 text-dark/70 text-base sm:text-lg leading-relaxed">
                      {event.detail}
                    </p>
                  )
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <script>
      document.querySelectorAll<HTMLDetailsElement>('[data-stable-announcement-details]').forEach((details) => {
        const summary = details.querySelector('summary');
        if (!summary) return;

        let summaryTopBeforeToggle: number | null = null;

        summary.addEventListener('click', () => {
          summaryTopBeforeToggle = summary.getBoundingClientRect().top;
        });

        details.addEventListener('toggle', () => {
          if (summaryTopBeforeToggle === null) return;

          requestAnimationFrame(() => {
            if (summaryTopBeforeToggle === null) return;

            const summaryTopAfterToggle = summary.getBoundingClientRect().top;
            const scrollDelta = summaryTopAfterToggle - summaryTopBeforeToggle;

            if (Math.abs(scrollDelta) > 1) {
              const root = document.documentElement;
              const previousScrollBehavior = root.style.scrollBehavior;

              root.style.scrollBehavior = 'auto';
              window.scrollBy(0, scrollDelta);
              root.style.scrollBehavior = previousScrollBehavior;
            }

            summaryTopBeforeToggle = null;
          });
        });
      });
    </script>
  </section>

  <!-- ═══ HUT-BOX ══════════════════════════════════════════════════════════ -->
  <section class="py-14 sm:py-20 bg-dark">
    <div class="max-w-3xl mx-auto px-6 text-center">

      <Image
        src={hatImg}
        alt=""
        width={832}
        height={832}
        class="w-[15.6rem] sm:w-[19.5rem] h-auto mx-auto mb-8"
        aria-hidden="true"
        loading="lazy"
      />

      <h2 class="font-display text-5xl sm:text-6xl text-white mb-6 leading-tight">
        {t.home.hut_heading}
      </h2>
      <p class="text-white/65 text-lg sm:text-xl leading-relaxed max-w-2xl mx-auto">
        {t.home.hut_text}
      </p>

    </div>
  </section>

  <!-- ═══ FEATURED ARTISTS ═════════════════════════════════════════════════ -->
  {featuredArtists.length > 0 && (
    <section class="py-20 sm:py-28 bg-bg">
      <div class="max-w-7xl mx-auto px-6">

        <div class="flex items-baseline justify-between mb-12">
          <h2 class="font-display text-5xl">{t.home.featured_heading}</h2>
          <a href={localize(ROUTES.artists)} class="text-primary font-semibold hover:underline text-sm sm:text-base shrink-0 ml-4">
            {t.nav.artists} →
          </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6" data-featured-artists-grid>
          {featuredArtists.map((artist, index) => {
            const firstCat = artist.data[locale]?.categories?.[0];
            const objectPosition = imagePositionToObjectPosition(artist.data.image_position);
            const imageAlt = locale === 'en'
              ? `${artist.data.name} at Spektakel Landshut 2026`
              : `${artist.data.name} beim Spektakel Landshut 2026`;
            return (
              <a
                href={localize(artistPath(artist.data.artist_id))}
                class:list={[
                  'featured-artist-card group block rounded-xl overflow-hidden bg-white shadow-md hover:shadow-xl transition-[opacity,transform,box-shadow] duration-300',
                  index >= 4 && 'hidden',
                ]}
                data-featured-artist
              >
                <div class="aspect-[3/4] overflow-hidden bg-gray-100">
                  <Picture
                    src={artist.data.images![0]}
                    alt={imageAlt}
                    class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                    style={`object-position: ${objectPosition};`}
                    loading="lazy"
                  />
                </div>
                <div class="p-4">
                  <p class="font-display text-xl leading-tight mb-2">{artist.data.name}</p>
                  {firstCat && (
                    <Badge variant="category" category={firstCat.toLowerCase()}>
                      {firstCat}
                    </Badge>
                  )}
                </div>
              </a>
            );
          })}
        </div>

        <style is:inline>
          [data-featured-artist] {
            opacity: 1;
            transform: translateY(0) scale(1);
            transition-duration: var(--featured-artist-transition-duration, 300ms) !important;
            will-change: opacity, transform;
          }

          [data-featured-artist].is-entering {
            opacity: 0;
            transform: translateY(0.75rem) scale(0.98);
          }

          [data-featured-artist].is-exiting {
            opacity: 0;
            transform: translateY(-0.75rem) scale(0.98);
            pointer-events: none;
          }

          @media (prefers-reduced-motion: reduce) {
            [data-featured-artist] {
              transition: none !important;
            }
          }
        </style>

        <script is:inline>
          const grid = document.querySelector('[data-featured-artists-grid]');
          const cards = Array.from(grid?.querySelectorAll('[data-featured-artist]') ?? []);
          const visibleCards = [];
          const visibleCount = Math.min(4, cards.length);
          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const rotateDelay = 5200;
          const exitTransitionDelay = 700;
          const enterTransitionDelay = 950;
          let nextCardIndex = visibleCount;
          let visibleSlot = 0;
          let rotationTimer;
          let isPaused = false;

          for (let i = cards.length - 1; i > 0; i -= 1) {
            const j = Math.floor(Math.random() * (i + 1));
            [cards[i], cards[j]] = [cards[j], cards[i]];
          }

          cards.forEach((card) => card.classList.add('hidden'));
          cards.slice(0, visibleCount).forEach((card) => {
            card.classList.remove('hidden');
            grid?.appendChild(card);
            visibleCards.push(card);
          });

          function findNextCard() {
            for (let i = 0; i < cards.length; i += 1) {
              const candidate = cards[nextCardIndex % cards.length];
              nextCardIndex += 1;

              if (!visibleCards.includes(candidate)) {
                return candidate;
              }
            }

            return null;
          }

          function rotateFeaturedArtist() {
            if (!grid || isPaused || document.hidden || cards.length <= visibleCount) return;

            const outgoing = visibleCards[visibleSlot];
            const incoming = findNextCard();
            if (!outgoing || !incoming || outgoing.contains(document.activeElement)) return;

            outgoing.style.setProperty('--featured-artist-transition-duration', `${exitTransitionDelay}ms`);
            outgoing.classList.add('is-exiting');

            window.setTimeout(() => {
              outgoing.classList.add('hidden');
              outgoing.classList.remove('is-exiting');
              outgoing.style.removeProperty('--featured-artist-transition-duration');

              incoming.style.setProperty('--featured-artist-transition-duration', `${enterTransitionDelay}ms`);
              incoming.classList.add('is-entering');
              incoming.classList.remove('hidden');
              grid.insertBefore(incoming, outgoing);
              visibleCards[visibleSlot] = incoming;
              visibleSlot = (visibleSlot + 1) % visibleCount;

              incoming.getBoundingClientRect();
              incoming.classList.remove('is-entering');
              window.setTimeout(() => {
                incoming.style.removeProperty('--featured-artist-transition-duration');
              }, enterTransitionDelay);
            }, exitTransitionDelay);
          }

          function startRotation() {
            if (prefersReducedMotion || cards.length <= visibleCount) return;
            window.clearInterval(rotationTimer);
            rotationTimer = window.setInterval(rotateFeaturedArtist, rotateDelay);
          }

          grid?.addEventListener('mouseenter', () => {
            isPaused = true;
          });

          grid?.addEventListener('mouseleave', () => {
            isPaused = false;
          });

          grid?.addEventListener('focusin', () => {
            isPaused = true;
          });

          grid?.addEventListener('focusout', () => {
            isPaused = grid.contains(document.activeElement);
          });

          document.addEventListener('visibilitychange', () => {
            if (!document.hidden) startRotation();
          });

          startRotation();
        </script>

      </div>
    </section>
  )}

  <!-- ═══ SPIELPLAN-VORSCHAU ════════════════════════════════════════════════ -->
  {previewEntries.length > 0 && (
    <section class="py-20 sm:py-28 bg-dark">
      <div class="max-w-3xl mx-auto px-6">

        <div class="flex items-baseline justify-between mb-3">
          <h2 class="font-display text-5xl text-white">{t.home.schedule_heading}</h2>
          <a href={localize(ROUTES.program)} class="text-lime font-semibold hover:underline text-sm sm:text-base shrink-0 ml-4">
            {t.home.schedule_link}
          </a>
        </div>
        <p class="text-white/40 text-sm mb-10">{dayLabels[previewDay] ?? previewDay}</p>

        <ul class="list-none p-0 m-0">
          {previewEntries.map(entry => {
            const artist = artistMap[entry.artist_id];
            return (
              <li class="flex items-center gap-5 py-4 border-b border-white/10 last:border-0">
                <span class="font-display text-2xl text-lime w-16 shrink-0 tabular-nums">
                  {formatTime(entry.time)}
                </span>
                <div class="min-w-0">
                  <p class="text-white font-semibold truncate">
                    {artist?.data.name ?? entry.artist_id}
                  </p>
                  <p class="text-white/40 text-xs mt-0.5">{entry.location_id}</p>
                </div>
              </li>
            );
          })}
        </ul>

      </div>
    </section>
  )}

</Page>

