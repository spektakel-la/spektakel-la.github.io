---
import Page from '../layouts/Page.astro';
---

<Page
  title="Seite nicht gefunden | Page not found"
  description="Die angeforderte Seite wurde nicht gefunden. The requested page could not be found."
  locale="de"
>
  <section class="flex min-h-[65vh] items-center bg-white py-20">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <p class="font-display text-8xl leading-none text-primary sm:text-9xl" aria-hidden="true">404</p>
      <h1 class="mt-5 font-display text-4xl text-dark sm:text-6xl">Seite nicht gefunden</h1>
      <p class="mt-4 text-lg text-dark/65">Die gesuchte Seite existiert nicht oder wurde verschoben.</p>
      <a class="mt-8 inline-flex rounded bg-primary px-6 py-3 font-semibold text-white transition hover:bg-primary/85" href="/">
        Zur Startseite
      </a>

      <div class="mx-auto my-10 h-px max-w-sm bg-dark/10"></div>

      <h2 class="font-display text-3xl text-dark sm:text-4xl">Page not found</h2>
      <p class="mt-3 text-dark/65">The page you requested does not exist or has been moved.</p>
      <a class="mt-6 inline-flex rounded border-2 border-dark px-6 py-3 font-semibold text-dark transition hover:border-primary hover:text-primary" href="/en/">
        Go to the English homepage
      </a>
    </div>
  </section>
</Page>
