---
import { getCollection, type CollectionEntry } from 'astro:content';
import ArtistDetail from '../../components/features/artists/ArtistDetail.astro';

export async function getStaticPaths() {
  const artists: CollectionEntry<'artists'>[] = await getCollection('artists');
  return artists
    .filter((a) => !a.data.organizational)
    .map((artist) => ({
      params: { slug: artist.data.artist_id },
      props: { artist },
    }));
}

const { artist } = Astro.props;
---
<ArtistDetail artist={artist} locale="de" />
