---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  locale?: string;
  canonicalUrl?: string;
}

const {
  title = 'Spektakel Landshut – Strassenkunst Festival',
  description = 'Das Strassenkunst-Festival in Landshut: Akrobatik, Jonglage, Musik, Comedy und Street Art mitten in der Altstadt.',
  ogImage = '/assets/img/logo/logo.webp',
  locale = 'de',
  canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href,
} = Astro.props;

const isEn = locale === 'en';
const siteName = 'Spektakel Landshut';
const fullTitle = title.includes('SPEKTAKEL') ? title : `${title} – ${siteName}`;
const canonical = new URL(canonicalUrl);
const localizedPath = isEn
  ? canonical.pathname.replace(/^\/en(?=\/|$)/, '') || '/'
  : canonical.pathname;
const deUrl = new URL(localizedPath, canonical.origin).href;
const enUrl = new URL(`/en${localizedPath === '/' ? '/' : localizedPath}`, canonical.origin).href;
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ff2d7a" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <!-- Hreflang -->
    <link rel="alternate" hreflang="de" href={deUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={deUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, canonical.origin).href} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={isEn ? 'en_US' : 'de_DE'} />
    <meta property="og:locale:alternate" content={isEn ? 'de_DE' : 'en_US'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, canonical.origin).href} />

    <!-- Favicon -->
    <link rel="icon" type="image/webp" href="/assets/img/logo/logo.webp" />

    <!-- Consent-API + GTM: GTM wird erst nach Analytics-Zustimmung geladen. -->
    <script is:inline>
      (function () {
        var storageKey = 'gtm-consent';
        var validStates = ['accepted', 'declined'];
        var storedState = null;
        try {
          storedState = localStorage.getItem(storageKey);
        } catch (_) {}

        var state = validStates.indexOf(storedState) !== -1 ? storedState : 'pending';
        window.spektakel = window.spektakel || {};
        window.spektakel.consent = {
          getStatus: function () { return state; },
          isAnalyticsGranted: function () { return state === 'accepted'; },
          setStatus: function (nextState) {
            if (validStates.indexOf(nextState) === -1) return;
            state = nextState;
            try { localStorage.setItem(storageKey, nextState); } catch (_) {}
            if (nextState === 'declined') {
              // Von GA gesetzte First-Party-Cookies beim Widerruf entfernen.
              try {
                document.cookie.split(';').forEach(function (cookie) {
                  var name = cookie.split('=')[0].trim();
                  if (!/^(_ga|_gid|_gat|_gac_|_gcl_)/.test(name)) return;
                  var expires = '=; Max-Age=0; path=/; SameSite=Lax';
                  document.cookie = name + expires;
                  document.cookie = name + expires + '; domain=' + location.hostname;
                  document.cookie = name + expires + '; domain=.' + location.hostname;
                });
              } catch (_) {}
            }
            window.dispatchEvent(new CustomEvent('spektakel:consent-changed', {
              detail: { status: state, analytics: state === 'accepted' }
            }));
          }
        };
      })();

      window.__gtmLoaded = false;
      function loadGtm() {
        if (window.__gtmLoaded) return;
        window.__gtmLoaded = true;
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l !== 'dataLayer' ? '&l=' + l : '';
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', 'GTM-TK5422TV');
      }

      if (window.spektakel.consent.isAnalyticsGranted()) loadGtm();
      window.addEventListener('spektakel:consent-changed', function (event) {
        if (event.detail && event.detail.analytics) loadGtm();
      });
    </script>
    <script is:inline>
      (function () {
        if (!('serviceWorker' in navigator)) return;

        var allowedHosts = ['localhost', '127.0.0.1', 'spektakel-la.github.io'];
        if (allowedHosts.indexOf(window.location.hostname) === -1) return;

        async function clearServiceWorkers() {
          try {
            await navigator.serviceWorker.register('/sw.js', { scope: '/' });

            if ('caches' in window) {
              var cacheNames = await caches.keys();
              await Promise.all(cacheNames.map(function (cacheName) {
                return caches.delete(cacheName);
              }));
            }

            var registrations = await navigator.serviceWorker.getRegistrations();
            await Promise.all(registrations.map(function (registration) {
              return registration.unregister();
            }));
          } catch (error) {
            console.warn('[ServiceWorker cleanup] Failed:', error);
          }
        }

        window.addEventListener('load', clearServiceWorkers, { once: true });
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="bg-[var(--color-bg)] text-[var(--color-dark)] font-body antialiased">
    <slot />

  </body>
</html>
